const damageNumberPool = [];

for(let i=0;i<20;i++){

    const el = document.createElement('div');

    el.style.position = 'absolute';
    el.style.left = '0px';
    el.style.top = '0px';
    el.style.transform = 'translate(-50%,-50%)';
    el.style.fontSize = '24px';
    el.style.fontWeight = 'bold';
    el.style.pointerEvents = 'none';
    el.style.opacity = '0';
    el.style.textShadow = '0 0 8px #000';
    el.style.display = 'none';

    damageNumberLayer.appendChild(el);

    damageNumberPool.push({
        el,
        active:false,
        life:0,
        maxLife:0.8,
        x:0,
        y:0
    });
}

function spawnDamageNumber(worldPos,value,type='normal'){

    const item = damageNumberPool.find(v=>!v.active);

    if(!item)return;

    const screen = tempScreen;

    screen.copy(worldPos);
    screen.project(camera);

    const x =
    (screen.x * 0.5 + 0.5) * window.innerWidth;

    const y =
    (-screen.y * 0.5 + 0.5) * window.innerHeight;

    item.active = true;
    item.life = item.maxLife;
    item.x = x;
    item.y = y;

    item.el.style.display = 'block';
    item.el.style.opacity = '1';
    item.el.style.left = `${x}px`;
    item.el.style.top = `${y}px`;

    if(type==='headshot'){

        item.el.innerHTML = `<b>${Math.floor(value)}</b>`;
        item.el.style.color = 'gold';
        item.el.style.fontSize = '30px';

    }else if(type==='armor'){

        item.el.innerHTML = `${Math.floor(value)}`;
        item.el.style.color = '#ff9933';
        item.el.style.fontSize = '26px';

    }else{

        item.el.innerHTML = `${Math.floor(value)}`;
        item.el.style.color = 'white';
        item.el.style.fontSize = '24px';
    }
}

function spawnBoss(){

    if(boss)return;

    const group = new THREE.Group();

    const body = new THREE.Mesh(

        new THREE.BoxGeometry(4,5,4),

        new THREE.MeshStandardMaterial({

            color:'#6600cc',

            emissive:0x220044

        })
    );

    body.castShadow=true;
    body.name='head';

    const eyeMat =
    new THREE.MeshStandardMaterial({

        color:'#ff0000',

        emissive:0xff0000

    });

    const eyeL = new THREE.Mesh(

        new THREE.BoxGeometry(.5,.5,.2),

        eyeMat
    );

    eyeL.position.set(-1,1,2.1);

    const eyeR = eyeL.clone();

    eyeR.position.x=1;

    const aura = new THREE.PointLight(
        0xaa00ff,
        3,
        20
    );

    aura.position.y=2;

    group.add(body);
    group.add(eyeL);
    group.add(eyeR);
    group.add(aura);

    group.position.set(0,30,0);

    scene.add(group);

    boss={

        mesh:group,

        body,

        eyeL,
        eyeR,

        hp:500,

        alive:true,

        mode:'range',

        modeTimer:5,

        speed:4,

        spawnTimer:1.5,

        spawned:false,

        attackTimer:0,

        chargeTimer:0,

        deathTimer:1,

        dead:false,

        hitCooldown:0,

        aura

    };

    bossBarWrap.style.display='block';

    showCenterText(
        'BOSS APPROACHING',
        '#aa00ff',
        2000
    );
}

function enemySpawn(
x,
z,
hpMul,
speedMul,
type='normal'
){

const group = new THREE.Group();

const body = new THREE.Mesh(

new THREE.BoxGeometry(

type==='elite'?2:1.5,

type==='elite'?3:2.5,

type==='elite'?2:1.5

),
new THREE.MeshStandardMaterial({
color:type==='elite'?0xffaa00:0xff3333,

emissive:type==='elite'
?0x442200
:0x440000
})
);

body.castShadow=true;
group.add(body);

const hasHelmet =
type==='elite'
&&Math.random()<0.3;

const headVisual = new THREE.Mesh(

new THREE.BoxGeometry(

type==='elite'?1.4:1.0,

type==='elite'?0.9:0.7,

type==='elite'?1.4:1.0

),

new THREE.MeshStandardMaterial({
color:hasHelmet
?'#888888'
:'#ffcccc'
})

);

headVisual.position.y =
type==='elite'
?1.95
:1.6;

headVisual.castShadow=true;
group.add(headVisual);

const headCollision = new THREE.Mesh(
new THREE.BoxGeometry(
type==='elite'?2.2:1.6,
type==='elite'?1.2:0.95,
type==='elite'?2.2:1.6
),
new THREE.MeshStandardMaterial({visible:false})
);
headCollision.position.y = headVisual.position.y - 0.05;
headCollision.name='head';
group.add(headCollision);

const glow = new THREE.PointLight(0xff0000,2,6);
glow.position.y=1;
group.add(glow);

group.scale.set(0,0,0);

// 出生时先埋在地面下方
group.position.set(x,-2,z);

const spawnLight = new THREE.PointLight(
    0x88ccff,
    2,
    5
);

spawnLight.position.set(0,1.2,0);

group.add(spawnLight);

scene.add(group);

enemies.push({
mesh:group,
body,
headVisual,
headCollision,
type,
damage:type==='elite'?10:5,
shootCD:type==='elite'?0.9:1.5,
hp:100*hpMul,
alive:true,
state:'patrol',
dir:Math.random()*Math.PI*2,
attack:0,
speed:2.5*speedMul,
spawn:0,
spawnDone:false,
spawnLight,
spawnLightTimer:0.3,
tempVec:new THREE.Vector3(),
moveVec:new THREE.Vector3(),
visionVec:new THREE.Vector3(),
shootVec:new THREE.Vector3(),
flashTimer:0,
helmet:hasHelmet,
deadTimer:0
});
}

//////////////////////////////////////////////////////////////
// ===== 波次系统 =====
//////////////////////////////////////////////////////////////

const waves=[3,5,7,10,12];
let wave=0;
let waitingWave=false;
let boss = null;
let bossSpawned = false;

function nextWave(){

if(wave>=waves.length){
win();
return;
}

wave++;
waveEl.textContent=wave;

showCenterText(`WAVE ${wave} START!`,'red',1500);

const count = waves[wave-1];

const eliteCount =
wave===1
?0
:Math.max(1,Math.floor(wave/2));

for(let i=0;i<count;i++){

let x,z;

let tries = 0;

while(tries < 50){

tries++;

x=(Math.random()*100)-50;
z=(Math.random()*100)-50;

tempNext.set(x,0,z);

if(!collide(tempNext)){
break;
}
}

if(tries >= 50){

x = 0;
z = 0;
}

const type =
i<eliteCount
?'elite'
:'normal';

totalEnemies++;

enemySpawn(

x,
z,

type==='elite'
?(1+wave*.2)*2.5
:(1+wave*.2),

type==='elite'
?(1+wave*.12)*0.8
:(1+wave*.12),

type
);
}
}

//////////////////////////////////////////////////////////////
// ===== 敌人视线检测 =====
//////////////////////////////////////////////////////////////

const raycaster = new THREE.Raycaster();

function canSeePlayer(enemy){

const dir = enemy.visionVec;

dir.subVectors(
camera.position,
enemy.mesh.position
);

const dist = dir.length();
dir.normalize();

raycaster.set(enemy.mesh.position,dir);

const hits = raycaster.intersectObjects(walls,false);

if(hits.length&&hits[0].distance<dist){
return false;
}

return true;
}

