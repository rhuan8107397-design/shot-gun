# Advanced Single File FPS Game HTML

```html
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Advanced FPS Arena</title>
<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
user-select:none;
}

html,body{
width:100%;
height:100%;
overflow:hidden;
background:#000;
font-family:Arial,sans-serif;
}

canvas{
display:block;
}

#ui{
position:fixed;
inset:0;
pointer-events:none;
color:white;
}

#crosshair{
position:absolute;
left:50%;
top:50%;
width:0;
height:0;
pointer-events:none;
z-index:100;
--ch-color:#ffffff;
--ch-outline:#000000;
}

.ch-line{
position:absolute;
background:var(--ch-color);
box-shadow:0 0 0 1px var(--ch-outline),0 0 8px var(--ch-color);
}

.ch-top,.ch-bottom{
width:2px;
height:6px;
left:-1px;
}

.ch-left,.ch-right{
width:6px;
height:2px;
top:-1px;
}

.ch-center{
position:absolute;
width:2px;
height:2px;
left:-1px;
top:-1px;
opacity:0;
background:var(--ch-color);
box-shadow:0 0 0 1px var(--ch-outline);
}

#crosshairCircle{
position:absolute;
border-radius:50%;
display:none;
border:2px solid var(--ch-color);
box-shadow:0 0 0 1px var(--ch-outline),0 0 10px var(--ch-color);
}

/* 命中标记：准星变色 */
.ch-line.hit-body {
  background: #ff3333 !important;
  box-shadow: 0 0 8px #ff3333 !important;
}
.ch-line.hit-head {
  background: #ffcc00 !important;
  box-shadow: 0 0 12px #ffcc00 !important;
  transform: scale(1.3);
}
.ch-center.hit-body { background: #ff3333 !important; }
.ch-center.hit-head { background: #ffcc00 !important; }

/* 击杀 X 标记 */
#killX {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24px;
  height: 24px;
  transform: translate(-50%, -50%) scale(0);
  opacity: 0;
  pointer-events: none;
  z-index: 101;
}
#killX::before,
#killX::after {
  content: '';
  position: absolute;
  width: 24px;
  height: 3px;
  background: #ffcc00;
  box-shadow: 0 0 10px #ffcc00;
  left: 0;
  top: 10px;
}
#killX::before { transform: rotate(45deg); }
#killX::after  { transform: rotate(-45deg); }
#killX.active {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  animation: killXPop 0.15s ease-out;
}
@keyframes killXPop {
  0%   { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
  50%  { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.0); opacity: 1; }
}
@keyframes comboPop {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.5); }
  100% { transform: scale(1); }
}

#hud{
position:absolute;
left:20px;
bottom:20px;
font-size:20px;
line-height:1.8;
text-shadow:0 0 10px #000;
}

#score{
position:absolute;
right:20px;
top:230px;
font-size:24px;
}

#shopMenu{
background:rgba(0,0,0,0.85);
}

.shopButton{
display:flex;
justify-content:space-between;
align-items:center;
width:400px;
padding:15px 20px;
margin:8px 0;
background:rgba(255,255,255,0.1);
border:2px solid rgba(255,255,255,0.3);
border-radius:8px;
color:white;
font-size:18px;
cursor:pointer;
pointer-events:auto;
}

.shopButton:hover{
background:rgba(255,255,255,0.2);
}

.shopButton.disabled{
opacity:0.4;
cursor:not-allowed;
}

#centerText{
position:absolute;
left:50%;
top:40%;
transform:translateX(-50%);
font-size:52px;
font-weight:bold;
text-shadow:0 0 25px red;
opacity:0;
transition:.3s;
}

#pickupText{
position:absolute;
left:50%;
top:55%;
transform:translateX(-50%);
font-size:34px;
font-weight:bold;
opacity:0;
transition:1s;
}

.menu{
position:absolute;
inset:0;
display:flex;
align-items:center;
justify-content:center;
flex-direction:column;
background:rgba(0,0,0,.8);
backdrop-filter:blur(4px);
pointer-events:auto;
}

.hidden{
display:none;
}

button{
padding:15px 35px;
font-size:24px;
font-weight:bold;
border:none;
border-radius:12px;
background:#00ffaa;
color:black;
cursor:pointer;
margin-top:20px;
}

h1{
font-size:72px;
margin-bottom:20px;
}

#damage{
position:absolute;
inset:0;
background:red;
opacity:0;
transition:.15s;
}

.lowHpEdge{
position:absolute;
pointer-events:none;
opacity:0;
transition:opacity .25s;
z-index:8;
}

.lowHpTop{
left:0;
top:0;
width:100%;
height:25%;
background:linear-gradient(to bottom,rgba(120,0,0,.9),rgba(120,0,0,0));
}

.lowHpBottom{
left:0;
bottom:0;
width:100%;
height:25%;
background:linear-gradient(to top,rgba(120,0,0,.9),rgba(120,0,0,0));
}

.lowHpLeft{
left:0;
top:0;
width:25%;
height:100%;
background:linear-gradient(to right,rgba(120,0,0,.9),rgba(120,0,0,0));
}

.lowHpRight{
right:0;
top:0;
width:25%;
height:100%;
background:linear-gradient(to left,rgba(120,0,0,.9),rgba(120,0,0,0));
}

#minimap{
position:absolute;
right:20px;
top:20px;
width:200px;
height:200px;
border-radius:50%;
border:2px solid rgba(255,255,255,0.4);
background:rgba(0,0,0,0.6);
overflow:hidden;
z-index:10;
}

#minimapPlayer{
position:absolute;
left:95px;
top:95px;
width:10px;
height:10px;
background:#3399ff;
clip-path:polygon(50% 0%,0% 100%,100% 100%);
transform-origin:center center;
z-index:3;
}

.minimapDot{
position:absolute;
border-radius:50%;
transform:translate(-50%,-50%);
z-index:2;
}

.minimapWall{
position:absolute;
background:rgba(128,128,128,0.3);
transform-origin:left center;
z-index:1;
}

.flashEdge{
position:absolute;
pointer-events:none;
opacity:0;
transition:none;
z-index:9;
background:white;
}

.flashTop{
left:0;
top:0;
width:100%;
height:20%;
}

.flashBottom{
left:0;
bottom:0;
width:100%;
height:20%;
}

.flashLeft{
left:0;
top:0;
width:20%;
height:100%;
}

.flashRight{
right:0;
top:0;
width:20%;
height:100%;
}

</style>
</head>
<body>

<div id="ui">
<div id="crosshair">
<div class="ch-line ch-top"></div>
<div class="ch-line ch-bottom"></div>
<div class="ch-line ch-left"></div>
<div class="ch-line ch-right"></div>
<div class="ch-center"></div>
<div id="crosshairCircle"></div>
<div id="killX"></div>
</div>

<div
id="adsDot"

style="
position:absolute;
left:50%;
top:50%;
width:2px;
height:2px;
background:red;
transform:translate(-50%,-50%);
opacity:0;
pointer-events:none;
z-index:20;
"
></div>

<div id="hud">
<div>HP: <span id="hp">100</span></div>
<div>Weapon: <span id="weapon">Rifle</span></div>
<div>Ammo: <span id="ammo">30</span></div>
<div>Reserve: <span id="reserve">120</span></div>
<div id="grenadeChargeWrap" style="margin-top:4px;width:120px;height:6px;background:#1a331a;border:1px solid #33ff33;opacity:0;">
  <div id="grenadeChargeBar" style="width:0%;height:100%;background:#33ff77;"></div>
</div>
<div>Wave: <span id="wave">1</span></div>
<div>TIME: <span id="timeText">00:00</span></div>
<div style="margin-top:6px;width:200px;height:8px;background:#173322;border:1px solid #44aa66;">
    <div id="staminaBar" style="width:100%;height:100%;background:#33ff77;"></div>
</div>
</div>

<div id="killFeed" style="
position:absolute;
right:20px;
top:80px;
display:flex;
flex-direction:column;
gap:6px;
pointer-events:none;
z-index:50;
"></div>

<div id="score">

<div
id="comboText"

style="
position:absolute;
right:20px;
top:70px;
font-size:32px;
font-weight:bold;
color:red;
opacity:0;
transition:.3s;
"
>
COMBO x1
</div>
Score: <span id="scoreText">0</span>
</div>

<div id="centerText"></div>
<div
id="bossBarWrap"
style="
position:absolute;
top:20px;
left:50%;
transform:translateX(-50%);
width:400px;
height:16px;
background:rgba(0,0,0,.7);
border:2px solid #aa00ff;
display:none;
z-index:20;
"
>

<div
id="bossBar"
style="
width:100%;
height:100%;
background:#aa00ff;
"
></div>

</div>
<div id="pickupText"></div>
<div id="damage"></div>
<div id="lowHpTop" class="lowHpEdge lowHpTop"></div>
<div id="lowHpBottom" class="lowHpEdge lowHpBottom"></div>
<div id="lowHpLeft" class="lowHpEdge lowHpLeft"></div>
<div id="lowHpRight" class="lowHpEdge lowHpRight"></div>
<div
id="damageNumberLayer"
style="
position:absolute;
inset:0;
pointer-events:none;
overflow:hidden;
"
></div>

<div id="minimap">
<div id="minimapWalls"></div>
<div id="minimapEnemies"></div>
<div id="minimapPlayer"></div>
</div>

<div id="flashTop" class="flashEdge flashTop"></div>
<div id="flashBottom" class="flashEdge flashBottom"></div>
<div id="flashLeft" class="flashEdge flashLeft"></div>
<div id="flashRight" class="flashEdge flashRight"></div>

<div id="startMenu" class="menu">
<h1>FPS ARENA</h1>
<p>WASD 移动 / 鼠标视角</p>
<p>1 2 3 切换武器</p>
<p>R 换弹 / 空格跳跃</p>
<button id="startBtn">Start</button>
</div>

<div id="pauseMenu" class="menu hidden">
<h1>PAUSED</h1>
<button id="resumeBtn">Resume</button>
<button id="settingsBtn" style="margin-top:10px;">Settings</button>
</div>

<div id="crosshairSettings" class="menu hidden">
<h2>CROSSHAIR</h2>
<div id="chPresets" style="display:flex;gap:10px;margin:20px 0;flex-wrap:wrap;justify-content:center;max-width:400px;"></div>
<div style="margin:15px 0;">
<label>Custom: </label>
<input type="color" id="chColorPicker" value="#ffffff">
</div>
<div style="margin:15px 0;">
<label>Opacity: <span id="chOpacityVal">100%</span></label>
<input type="range" id="chOpacitySlider" min="0.3" max="1" step="0.05" value="1">
</div>
<div style="margin:15px 0;">
<label>
<input type="checkbox" id="chOutlineCheck" checked> Black Outline
</label>
</div>
<button id="chSaveBtn">Apply</button>
<button id="chBackBtn">Back</button>
</div>

<div id="endMenu" class="menu hidden">
<h1 id="endTitle">YOU WIN</h1>
<div
id="stats"

style="
margin-top:20px;
font-size:24px;
text-align:center;
line-height:1.8;
"
></div>
<button onclick="location.reload()">Restart</button>
</div>

<div id="shopMenu" class="menu hidden">
<h1>UPGRADE SHOP</h1>
<div id="shopScore" style="margin-bottom:20px;font-size:24px;">Score: 0</div>
<div id="shopButtons" style="display:flex;flex-direction:column;align-items:center;"></div>
<button id="closeShopBtn" style="margin-top:20px;">CLOSE</button>
</div>

</div>

<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';


//////////////////////////////////////////////////////////////
// ===== 基础初始化 =====
//////////////////////////////////////////////////////////////

const scene = new THREE.Scene();
scene.fog = new THREE.Fog(0x9aa0aa,50,180);

// procedural skybox
const skyGeo=new THREE.SphereGeometry(200,64,64);
const skyMat=new THREE.ShaderMaterial({
    uniforms:{
        uTopColor:{value:new THREE.Color(0x8a9bb0)},
        uHorizonColor:{value:new THREE.Color(0xd4c5b5)},
        uBottomColor:{value:new THREE.Color(0xb8b0a8)},
        uOffset:{value:0.1},
        uExponent:{value:0.8}
    },
    vertexShader:`varying vec3 vWorldPosition;void main(){vec4 wp=modelMatrix*vec4(position,1.0);vWorldPosition=wp.xyz;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
    fragmentShader:`uniform vec3 uTopColor;uniform vec3 uHorizonColor;uniform vec3 uBottomColor;uniform float uOffset;uniform float uExponent;varying vec3 vWorldPosition;void main(){float h=normalize(vWorldPosition).y;float t=max(0.0,min(1.0,(h+uOffset)/(1.0+uOffset*2.0)));t=pow(t,uExponent);vec3 col=mix(uBottomColor,uHorizonColor,t);col=mix(col,uTopColor,smoothstep(0.5,0.8,t));gl_FragColor=vec4(col,1.0);}`,
    side:THREE.BackSide,depthWrite:false
});
const skyDome=new THREE.Mesh(skyGeo,skyMat);
skyDome.renderOrder=-1;
scene.add(skyDome);

const camera = new THREE.PerspectiveCamera(
75,
window.innerWidth/window.innerHeight,
0.1,
300
);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.setSize(window.innerWidth,window.innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 0.9;
document.body.appendChild(renderer.domElement);

//////////////////////////////////////////////////////////////
// ===== UI =====
//////////////////////////////////////////////////////////////

const hpEl = document.getElementById('hp');
const ammoEl = document.getElementById('ammo');
const reserveEl = document.getElementById('reserve');
const weaponEl = document.getElementById('weapon');
const scoreEl = document.getElementById('scoreText');
const comboText = document.getElementById('comboText');
const timeText = document.getElementById('timeText');
const staminaBar = document.getElementById('staminaBar');
const bossBarWrap = document.getElementById('bossBarWrap');
const bossBar = document.getElementById('bossBar');
let surviveTime=0;
let score = 0;

let combo = 0;
let comboTimer = 0;
let bestCombo = 0;

let timeScale = 1.0;
let whiteFlashOpacity = 0;

let kills = 0;
let totalEnemies = 0;

const bestScore = Number(
localStorage.getItem('fps_best') || 0
);
const waveEl = document.getElementById('wave');
const crosshair = document.getElementById('crosshair');
const adsDot = document.getElementById('adsDot');
const centerText = document.getElementById('centerText');
const pickupText = document.getElementById('pickupText');
const damageNumberLayer = document.getElementById('damageNumberLayer');
const lowHpEdges = [
    document.getElementById('lowHpTop'),
    document.getElementById('lowHpBottom'),
    document.getElementById('lowHpLeft'),
    document.getElementById('lowHpRight')
];

const flashEdges = [
    document.getElementById('flashTop'),
    document.getElementById('flashBottom'),
    document.getElementById('flashLeft'),
    document.getElementById('flashRight')
];

const minimap = document.getElementById('minimap');
const minimapPlayer = document.getElementById('minimapPlayer');
const minimapWalls = document.getElementById('minimapWalls');
const minimapEnemies = document.getElementById('minimapEnemies');

//////////////////////////////////////////////////////////////
// ===== 菜单 =====
//////////////////////////////////////////////////////////////

const startMenu = document.getElementById('startMenu');
const pauseMenu = document.getElementById('pauseMenu');
const endMenu = document.getElementById('endMenu');
const shopMenu = document.getElementById('shopMenu');
const shopScore = document.getElementById('shopScore');
const shopButtons = document.getElementById('shopButtons');
const closeShopBtn = document.getElementById('closeShopBtn');
const endTitle = document.getElementById('endTitle');

let paused=true;
let gameOver=false;
let started=false;
let lowHpActive = false;
let heartbeatTimer = 0;
let breathTimer = 0;

//////////////////////////////////////////////////////////////
// ===== Pointer Lock =====
//////////////////////////////////////////////////////////////

function lock(){

    getAudio();

    if(audioCtx && audioCtx.state === 'suspended'){
        audioCtx.resume();
    }

    renderer.domElement.requestPointerLock();
}

document.getElementById('startBtn').onclick=lock;
document.getElementById('resumeBtn').onclick=lock;

document.addEventListener('pointerlockchange',()=>{

if(document.pointerLockElement===renderer.domElement){
paused=false;
startMenu.classList.add('hidden');
pauseMenu.classList.add('hidden');
shopMenu.classList.add('hidden');
}else{
if(started&&!gameOver){
    if(shopMenu.classList.contains('hidden')){
        paused=true;
        pauseMenu.classList.remove('hidden');
    }
}
}
});

// crosshair settings
const chSettings=document.getElementById('crosshairSettings');
const chPresets=document.getElementById('chPresets');
const chColorPicker=document.getElementById('chColorPicker');
const chOpacitySlider=document.getElementById('chOpacitySlider');
const chOpacityVal=document.getElementById('chOpacityVal');
const chOutlineCheck=document.getElementById('chOutlineCheck');

const presetColors=['#ffffff','#00ffcc','#33ff77','#ffff00','#ff66cc','#ff8800','#ff4444','#88ccff'];
presetColors.forEach(function(c){
    const div=document.createElement('div');
    div.style.cssText='width:32px;height:32px;border-radius:4px;background:'+c+';cursor:pointer;border:2px solid #333;';
    div.onclick=function(){
        crosshairConfig.color=c;
        chColorPicker.value=c;
        applyCrosshairStyle();
    };
    chPresets.appendChild(div);
});

chColorPicker.addEventListener('input',function(e){
    crosshairConfig.color=e.target.value;
    applyCrosshairStyle();
});

chOpacitySlider.addEventListener('input',function(e){
    crosshairConfig.opacity=parseFloat(e.target.value);
    chOpacityVal.textContent=Math.round(crosshairConfig.opacity*100)+'%';
    applyCrosshairStyle();
});

chOutlineCheck.addEventListener('change',function(e){
    crosshairConfig.outlineColor=e.target.checked?'#000000':'transparent';
    applyCrosshairStyle();
});

document.getElementById('chSaveBtn').onclick=function(){
    saveCrosshairConfig();
};

document.getElementById('chBackBtn').onclick=function(){
    chSettings.classList.add('hidden');
    pauseMenu.classList.remove('hidden');
};

document.getElementById('settingsBtn').onclick=function(){
    pauseMenu.classList.add('hidden');
    chSettings.classList.remove('hidden');
};

//////////////////////////////////////////////////////////////
// ===== 灯光 =====
//////////////////////////////////////////////////////////////

const hemi = new THREE.HemisphereLight(0xb0c0d0,0x8a7e72,1.2);
scene.add(hemi);

const dir = new THREE.DirectionalLight(0xe0d5c8,0.6);
dir.position.set(30,40,20);
dir.castShadow=true;
dir.shadow.mapSize.set(2048,2048);
scene.add(dir);

//////////////////////////////////////////////////////////////
// ===== 地板 =====
//////////////////////////////////////////////////////////////

const floor = new THREE.Mesh(
new THREE.PlaneGeometry(160,160),
new THREE.MeshStandardMaterial({
color:0x5a6578,roughness:0.85,metalness:0.0
})
);

floor.rotation.x=-Math.PI/2;
floor.receiveShadow=true;
scene.add(floor);

//////////////////////////////////////////////////////////////
// ===== 程序化地图生成 =====
//////////////////////////////////////////////////////////////

const walls=[];
const rooms=[];
const barrels = [];
const explosionFragments = [];
const fluorescentLights = [];

// shared materials
const matWall=new THREE.MeshStandardMaterial({color:'#6b7280',roughness:0.9,metalness:0.0});
const matWallCorridor=new THREE.MeshStandardMaterial({color:'#6a7585',roughness:0.9,metalness:0.0});
const matCrate=new THREE.MeshStandardMaterial({color:'#4a5568',roughness:0.85,metalness:0.0});
const matStripe=new THREE.MeshStandardMaterial({color:'#ccbbaa',roughness:0.9,metalness:0.0});
const matHalfWall=new THREE.MeshStandardMaterial({color:'#7f8c8d',roughness:0.9,metalness:0.0});
const matDesk=new THREE.MeshStandardMaterial({color:'#554433',roughness:0.85,metalness:0.0});
const matPlatform=new THREE.MeshStandardMaterial({color:'#4a5568',roughness:0.9,metalness:0.0});
const matCeiling=new THREE.MeshStandardMaterial({color:'#505560',roughness:1.0,metalness:0.0});
const matPillar=new THREE.MeshStandardMaterial({color:'#555a60',roughness:0.9,metalness:0.0});
const matCurb=new THREE.MeshStandardMaterial({color:'#555a60',roughness:0.9,metalness:0.0});

function createWall(x,z,w,h,d){
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w,h,d),matWall);
    mesh.position.set(x,h/2,z);
    mesh.castShadow=true;
    mesh.receiveShadow=true;
    scene.add(mesh);
    walls.push(mesh);
}

function createWallCorridor(x,z,w,h,d){
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w,h,d),matWallCorridor);
    mesh.position.set(x,h/2,z);
    mesh.castShadow=true;
    mesh.receiveShadow=true;
    scene.add(mesh);
    walls.push(mesh);
}

function createBarrel(x,z){
    const group = new THREE.Group();
    const body = new THREE.Mesh(
        new THREE.CylinderGeometry(1,1,3,16),
        new THREE.MeshStandardMaterial({color:'#cc0000',emissive:0x330000})
    );
    body.castShadow = true;
    body.receiveShadow = true;
    body.name = 'barrel';
    const stripe = new THREE.Mesh(
        new THREE.CylinderGeometry(1.03,1.03,0.18,16),
        new THREE.MeshStandardMaterial({color:'#ffcc00',emissive:0x332200})
    );
    stripe.position.y = 0.8;
    group.add(body); group.add(stripe);
    group.position.set(x,1.5,z);
    scene.add(group);
    barrels.push({mesh:group,body,hp:3,alive:true,flashTimer:0});
}

function createCrate(x,z,w,d,h){
    if(!h)h=2.5;
    const crate=new THREE.Group();
    const body=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),matCrate);
    body.position.y=h/2;
    body.castShadow=true; body.receiveShadow=true;
    crate.add(body);
    const stripe=new THREE.Mesh(new THREE.BoxGeometry(w+0.05,0.12,d+0.05),matStripe);
    stripe.position.y=h+0.02;
    crate.add(stripe);
    crate.position.set(x,0,z);
    scene.add(crate);
    walls.push(new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshBasicMaterial({visible:false})));
    walls[walls.length-1].position.set(x,h/2,z);
    // AO contact shadow
    const aoGeo2=new THREE.PlaneGeometry(w*1.05,d*1.05);
    const aoMat2=new THREE.MeshBasicMaterial({color:0x000000,transparent:true,opacity:0.25});
    const aoPlane2=new THREE.Mesh(aoGeo2,aoMat2);
    aoPlane2.rotation.x=-Math.PI/2;
    aoPlane2.position.set(x,0.03,z);
    scene.add(aoPlane2);
}

function createHalfWall(x,z,w,d){
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,1.2,d),matHalfWall);
    mesh.position.set(x,0.6,z);
    mesh.castShadow=true; mesh.receiveShadow=true;
    scene.add(mesh);
    walls.push(mesh);
}

function createDesk(x,z){
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(1.2,0.7,0.8),matDesk);
    mesh.position.set(x,0.35,z);
    mesh.castShadow=true; mesh.receiveShadow=true;
    scene.add(mesh);
    walls.push(mesh);
    // AO
    const aoGeo3=new THREE.PlaneGeometry(1.3,0.9);
    const aoMat3=new THREE.MeshBasicMaterial({color:0x000000,transparent:true,opacity:0.25});
    const aoPlane3=new THREE.Mesh(aoGeo3,aoMat3);
    aoPlane3.rotation.x=-Math.PI/2;
    aoPlane3.position.set(x,0.03,z);
    scene.add(aoPlane3);
}

function createFluorescentTube(x,y,z){
    // tube mesh (StandardMaterial + weak emissive, not BasicMaterial)
    const tubeGeo=new THREE.BoxGeometry(0.15,0.08,1.8);
    const tubeMat=new THREE.MeshStandardMaterial({
        color:0xddddcc,emissive:0x222211,emissiveIntensity:0.2,roughness:1.0
    });
    const tube=new THREE.Mesh(tubeGeo,tubeMat);
    tube.position.set(x,y,z);
    scene.add(tube);

    // point light (warm neutral white, ~4500K)
    const fluoLight=new THREE.PointLight(0xeeeedd,0.6,18,2);
    fluoLight.position.set(x,y-0.4,z);
    scene.add(fluoLight);

    fluorescentLights.push({mesh:tube,light:fluoLight});

    // AO contact shadow plane
    const aoGeo=new THREE.PlaneGeometry(2,4);
    const aoMat=new THREE.MeshBasicMaterial({color:0x000000,transparent:true,opacity:0.2});
    const aoPlane=new THREE.Mesh(aoGeo,aoMat);
    aoPlane.rotation.x=-Math.PI/2;
    aoPlane.position.set(x,0.03,z);
    scene.add(aoPlane);

    return tube;
}

function createEmergencyLight(x,y,z){
    const emGeo=new THREE.BoxGeometry(0.08,0.08,0.08);
    const emMat=new THREE.MeshStandardMaterial({
        color:0xffaa77,emissive:0x331100,emissiveIntensity:0.3,roughness:1.0
    });
    const emMesh=new THREE.Mesh(emGeo,emMat);
    emMesh.position.set(x,y,z);
    scene.add(emMesh);
    const emLight=new THREE.PointLight(0xffaa77,0.15,3);
    emLight.position.set(x,y,z);
    scene.add(emLight);
}

function createPillar(x,z,w,h,d){
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),matPillar);
    mesh.position.set(x,h/2,z);
    mesh.castShadow=true; mesh.receiveShadow=true;
    scene.add(mesh);
    walls.push(mesh);
    const aoGeo4=new THREE.PlaneGeometry(w*1.1,d*1.1);
    const aoMat4=new THREE.MeshBasicMaterial({color:0x000000,transparent:true,opacity:0.25});
    const aoPlane4=new THREE.Mesh(aoGeo4,aoMat4);
    aoPlane4.rotation.x=-Math.PI/2;
    aoPlane4.position.set(x,0.03,z);
    scene.add(aoPlane4);
}

function createCurb(x,z,len,dir){
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(dir==='x'?len:0.3,0.15,dir==='z'?len:0.3),matCurb);
    mesh.position.set(x,0.075,z);
    mesh.receiveShadow=true;
    scene.add(mesh);
}

function createCeiling(x,z,w,d,y){
    const mesh=new THREE.Mesh(new THREE.PlaneGeometry(w,d),matCeiling);
    mesh.rotation.x=-Math.PI/2;
    mesh.position.set(x,y||6,z);
    mesh.receiveShadow=true;
    scene.add(mesh);
}

function createPlatform(x,z,w,d,h){
    if(!h)h=1.5;
    const group=new THREE.Group();
    const body=new THREE.Mesh(new THREE.BoxGeometry(w,0.3,d),matPlatform);
    body.position.y=h;
    body.castShadow=true; body.receiveShadow=true;
    group.add(body);
    const stripe=new THREE.Mesh(new THREE.BoxGeometry(w+0.05,0.05,d+0.05),matStripe);
    stripe.position.y=h+0.15;
    group.add(stripe);
    group.position.set(x,0,z);
    scene.add(group);
    const collider=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshBasicMaterial({visible:false}));
    collider.position.set(x,h/2,z);
    scene.add(collider);
    walls.push(collider);
}

function createRamp(x,z,w,dir,topH){
    if(!topH)topH=1.5;
    const len=topH/Math.tan(15*Math.PI/180);
    const geo=new THREE.BoxGeometry(w,0.2,len);
    const mesh=new THREE.Mesh(geo,matPlatform);
    mesh.position.set(x,topH/2,z);
    mesh.rotation.x=dir==='z'?-15*Math.PI/180:0;
    mesh.rotation.z=dir==='x'?15*Math.PI/180:0;
    mesh.castShadow=true; mesh.receiveShadow=true;
    scene.add(mesh);
    const collider=new THREE.Mesh(new THREE.BoxGeometry(w,topH,len),new THREE.MeshBasicMaterial({visible:false}));
    collider.position.set(x,topH/2,z);
    scene.add(collider);
    walls.push(collider);
}

function createCrateStack(x,z){
    for(let i=0;i<3;i++){
        const crate=new THREE.Group();
        const body=new THREE.Mesh(new THREE.BoxGeometry(2,2.5,3),matCrate);
        body.position.y=1.25+i*2.5;
        body.castShadow=true; body.receiveShadow=true;
        crate.add(body);
        const stripe=new THREE.Mesh(new THREE.BoxGeometry(2.05,0.12,3.05),matStripe);
        stripe.position.y=2.5+i*2.5+0.02;
        crate.add(stripe);
        crate.position.set(x,0,z);
        scene.add(crate);
    }
    const collider=new THREE.Mesh(new THREE.BoxGeometry(2,7.5,3),new THREE.MeshBasicMaterial({visible:false}));
    collider.position.set(x,3.75,z);
    scene.add(collider);
    walls.push(collider);
}

function aabbOverlap(a,b){
    return Math.abs(a.x-b.x)<(a.w+b.w)/2 && Math.abs(a.z-b.z)<(a.d+b.d)/2;
}

function generateMap(){
    // 1. Generate rooms
    const totalRooms=4+Math.floor(Math.random()*3); // 4~6
    const roomPool=[];

    for(let i=0;i<totalRooms;i++){
        const rand=Math.random();
        let type, w, d;
        if(rand<0.4){
            type='storage'; w=12+Math.random()*6; d=12+Math.random()*6;
        }else if(rand<0.7){
            type='corridor'; w=4+Math.random()*2; d=20+Math.random()*20;
        }else if(rand<0.9){
            type='office'; w=10+Math.random()*4; d=10+Math.random()*4;
        }else{
            type='junction'; w=10; d=10;
        }

        let tries=0, placed=false;
        while(tries<20){
            tries++;
            const x=(Math.random()*120)-60;
            const z=(Math.random()*120)-60;
            const candidate={x,z,w,d,type};

            // check bounds
            if(Math.abs(x)+w/2>70||Math.abs(z)+d/2>70)continue;

            // check overlap with existing rooms
            let overlap=false;
            for(const r of roomPool){
                if(aabbOverlap(candidate,{x:r.x,z:r.z,w:r.w+4,d:r.d+4})){
                    overlap=true; break;
                }
            }
            if(overlap)continue;

            roomPool.push(candidate);
            placed=true;
            break;
        }
        if(!placed){
            // force place at edge
            const x=(Math.random()*120)-60;
            const z=(Math.random()*120)-60;
            roomPool.push({x,z,w,d,type});
        }
    }

    // 2. Build each room
    for(const r of roomPool){
        rooms.push({x:r.x,z:r.z,w:r.w,d:r.d,_type:r.type});
        createRoom(r.x,r.z,r.w,r.d,r.type);
    }

    // 3. MST connection (Kruskal-like: connect nearest unconnected)
    const connected=new Set([0]);
    const edges=[];
    while(connected.size<roomPool.length){
        let bestDist=Infinity, bestA=-1, bestB=-1;
        for(const a of connected){
            for(let b=0;b<roomPool.length;b++){
                if(connected.has(b))continue;
                const ra=roomPool[a], rb=roomPool[b];
                const dist=Math.abs(ra.x-rb.x)+Math.abs(ra.z-rb.z);
                if(dist<bestDist){bestDist=dist; bestA=a; bestB=b;}
            }
        }
        if(bestB>=0){
            connected.add(bestB);
            edges.push([bestA,bestB]);
            connectRooms(roomPool[bestA],roomPool[bestB]);
        }else break;
    }

    // 4. Redundant connections (1~2 extra)
    const extraCount=1+Math.floor(Math.random()*2);
    for(let i=0;i<extraCount;i++){
        const a=Math.floor(Math.random()*roomPool.length);
        const b=Math.floor(Math.random()*roomPool.length);
        if(a!==b&&!edges.some(e=>(e[0]===a&&e[1]===b)||(e[0]===b&&e[1]===a))){
            connectRooms(roomPool[a],roomPool[b]);
        }
    }

    // 5. Decorations
    // Barrels: 2 storage rooms
    const storages=roomPool.filter(r=>r.type==='storage');
    for(let i=0;i<Math.min(2,storages.length);i++){
        const s=storages[i];
        createBarrel(s.x+(Math.random()*4-2),s.z+(Math.random()*4-2));
    }

    // Crate stacks at map edges
    createCrateStack(-55,-55);
    createCrateStack(55,55);
}

function createRoom(x,z,w,d,type){
    const hw=w/2, hd=d/2;

    if(type==='storage'){
        // enclosed walls with entry gaps
        const gapW=3;
        const gapSide=Math.floor(Math.random()*4);
        const sides=[
            {x:x, z:z-hd, len:w, dir:'x'}, // north
            {x:x, z:z+hd, len:w, dir:'x'}, // south
            {x:x-hw, z:z, len:d, dir:'z'}, // west
            {x:x+hw, z:z, len:d, dir:'z'}  // east
        ];
        for(let si=0;si<4;si++){
            if(si===gapSide){
                // wall with gap
                const s=sides[si];
                const halfLen=(s.len-gapW)/2;
                if(s.dir==='x'){
                    if(halfLen>1){createWall(s.x-halfLen/2-gapW/2,s.z,halfLen,5,0.8);}
                    if(halfLen>1){createWall(s.x+halfLen/2+gapW/2,s.z,halfLen,5,0.8);}
                }else{
                    if(halfLen>1){createWall(s.x,s.z-halfLen/2-gapW/2,0.8,5,halfLen);}
                    if(halfLen>1){createWall(s.x,s.z+halfLen/2+gapW/2,0.8,5,halfLen);}
                }
            }else{
                const s=sides[si];
                createWall(s.x,s.z,s.dir==='x'?s.len:0.8,5,s.dir==='z'?s.len:0.8);
            }
        }

        // ceiling
        createCeiling(x,z,w,d,6);

        // light leaks (warm sunset glow strips)
        for(let li=0;li<3;li++){
            const leakGeo=new THREE.BoxGeometry(w*0.6,0.05,0.2);
            const leakMat=new THREE.MeshStandardMaterial({color:0xffeedd,emissive:0x443322,emissiveIntensity:0.2,roughness:1.0});
            const leak=new THREE.Mesh(leakGeo,leakMat);
            leak.position.set(x,5.8,z+(li-1)*d*0.25);
            scene.add(leak);
        }

        // crates: 2-4, with at least 1 channel (width>=3) and 1 L-shape
        const crateCount=2+Math.floor(Math.random()*3);
        for(let i=0;i<crateCount;i++){
            const cx=x+(Math.random()*w-w/2)*0.7;
            const cz=z+(Math.random()*d-d/2)*0.7;
            const cw=1.5+Math.random()*2.5;
            const cd=1.5+Math.random()*2.5;
            createCrate(cx,cz,cw,cd,2.5);
        }

    }else if(type==='corridor'){
        // open corridor, no internal cover, fluorescent tubes every 6 units
        const corridorWalls=[
            {x:x, z:z-hd, len:w, dir:'x'},
            {x:x, z:z+hd, len:w, dir:'x'},
        ];
        for(const s of corridorWalls){
            createWallCorridor(s.x,s.z,s.dir==='x'?s.len:0.8,5,s.dir==='z'?s.len:0.8);
        }
        // fluorescent tubes along center every 10 units
        for(let p=-hd+5;p<hd;p+=10){
            createFluorescentTube(x,4.2,z+p);
        }
        // emergency red lights at corridor ends
        createEmergencyLight(x,1.2,z-hd+1);
        createEmergencyLight(x,1.2,z+hd-1);

    }else if(type==='office'){
        // full walls
        createWall(x,z-hd,w,5,0.8);
        createWall(x,z+hd,w,5,0.8);
        createWall(x-hw,z,0.8,5,d);
        createWall(x+hw,z,0.8,5,d);

        // ceiling
        createCeiling(x,z,w,d,6);

        // light leaks (warm sunset glow strips)
        for(let li=0;li<2;li++){
            const leakGeo=new THREE.BoxGeometry(w*0.5,0.05,0.2);
            const leakMat=new THREE.MeshStandardMaterial({color:0xffeedd,emissive:0x443322,emissiveIntensity:0.2,roughness:1.0});
            const leak=new THREE.Mesh(leakGeo,leakMat);
            leak.position.set(x,5.8,z+(li-0.5)*d*0.3);
            scene.add(leak);
        }

        // half walls dividing into 2-3 partitions
        const parts=2+Math.floor(Math.random()*2);
        for(let i=0;i<parts-1;i++){
            const hx=x-w/2+(i+1)*w/parts;
            const hd2=d*0.7;
            createHalfWall(hx,z,0.4,hd2);
        }
        // desks per partition
        for(let i=0;i<parts;i++){
            const dx=x-w/2+i*w/parts+w/parts/2;
            const dz=z+(Math.random()*d*0.4-d*0.2);
            createDesk(dx,dz);
        }

    }else if(type==='junction'){
        // no enclosing walls, 4-way open
        const pz=2; // pillar size
        createPillar(x-w/2,z-d/2,pz,5,pz);
        createPillar(x+w/2,z-d/2,pz,5,pz);
        createPillar(x-w/2,z+d/2,pz,5,pz);
        createPillar(x+w/2,z+d/2,pz,5,pz);

        // central barrel
        createBarrel(x,z);
    }
}

function connectRooms(a,b){
    const cw=5; // corridor width

    // Manhattan path: randomly choose X-first or Z-first
    const xFirst=Math.random()>0.5;

    if(xFirst){
        // X segment then Z segment
        const midX=b.x;
        const minZ1=Math.min(a.z,b.z), maxZ1=Math.max(a.z,b.z);
        createWall(midX, a.z-cw/2-0.4, Math.abs(a.x-b.x)+2, 5, 0.8);
        createWall(midX, a.z+cw/2+0.4, Math.abs(a.x-b.x)+2, 5, 0.8);
        // curbs
        createCurb(midX, a.z-cw/2, Math.abs(a.x-b.x)+2, 'x');
        createCurb(midX, a.z+cw/2, Math.abs(a.x-b.x)+2, 'x');
        // Z segment
        createWall(b.x-cw/2-0.4, (minZ1+maxZ1)/2, 0.8, 5, Math.abs(a.z-b.z)+2);
        createWall(b.x+cw/2+0.4, (minZ1+maxZ1)/2, 0.8, 5, Math.abs(a.z-b.z)+2);
        createCurb(b.x-cw/2, (minZ1+maxZ1)/2, Math.abs(a.z-b.z)+2, 'z');
        createCurb(b.x+cw/2, (minZ1+maxZ1)/2, Math.abs(a.z-b.z)+2, 'z');
        // corner pillar
        createPillar(b.x, a.z, 1.5, 5, 1.5);
    }else{
        // Z segment then X segment
        const midZ=b.z;
        const minX1=Math.min(a.x,b.x), maxX1=Math.max(a.x,b.x);
        createWall(a.x-cw/2-0.4, midZ, 0.8, 5, Math.abs(a.z-b.z)+2);
        createWall(a.x+cw/2+0.4, midZ, 0.8, 5, Math.abs(a.z-b.z)+2);
        createCurb(a.x-cw/2, midZ, Math.abs(a.z-b.z)+2, 'z');
        createCurb(a.x+cw/2, midZ, Math.abs(a.z-b.z)+2, 'z');
        // X segment
        createWall((minX1+maxX1)/2, b.z-cw/2-0.4, Math.abs(a.x-b.x)+2, 5, 0.8);
        createWall((minX1+maxX1)/2, b.z+cw/2+0.4, Math.abs(a.x-b.x)+2, 5, 0.8);
        createCurb((minX1+maxX1)/2, b.z-cw/2, Math.abs(a.x-b.x)+2, 'x');
        createCurb((minX1+maxX1)/2, b.z+cw/2, Math.abs(a.x-b.x)+2, 'x');
        // corner pillar
        createPillar(a.x, b.z, 1.5, 5, 1.5);
    }
}

// Execute map generation
generateMap();

//////////////////////////////////////////////////////////////
// ===== 地图边界墙 =====
//////////////////////////////////////////////////////////////

function createBoundaryWall(x,y,z,w,h,d){
    const wall = new THREE.Mesh(
        new THREE.BoxGeometry(w,h,d),
        new THREE.MeshBasicMaterial({visible:false})
    );
    wall.position.set(x,y,z);
    scene.add(wall);
    walls.push(wall);
}

// left
createBoundaryWall(-80,10,0,4,20,160);
// right
createBoundaryWall(80,10,0,1,20,160);
// front
createBoundaryWall(0,10,-80,160,20,1);
// back
createBoundaryWall(0,10,80,160,20,1);

// Platforms: 1 storage room and 1 junction
var _storages=[]; var _junctions=[];
for(var _ri=0;_ri<rooms.length;_ri++){
    if(rooms[_ri]._type==='storage')_storages.push(rooms[_ri]);
    if(rooms[_ri]._type==='junction')_junctions.push(rooms[_ri]);
}
if(_storages.length>0){
    var s=_storages[0];
    createPlatform(s.x+2,s.z+2,4,4,1.5);
    createRamp(s.x,s.z+2,4,'z',1.5);
}
if(_junctions.length>0){
    var j=_junctions[0];
    createPlatform(j.x+2,j.z+2,3,3,1.5);
}
//////////////////////////////////////////////////////////////
// ===== 小地图初始化 =====
//////////////////////////////////////////////////////////////

const minimapEnemyDots=[];

for(let i=0;i<30;i++){

    const dot=document.createElement('div');

    dot.className='minimapDot';

    dot.style.display='none';

    minimapEnemies.appendChild(dot);

    minimapEnemyDots.push({
        el:dot,
        active:false
    });
}

function worldToMinimap(x,z){

    const mapX=100+x*(100/80);
    const mapY=100-z*(100/80);

    return {x:mapX,y:mapY};
}

for(const r of rooms){

    const corners=[
        {x:r.x-r.w/2,z:r.z-r.d/2},
        {x:r.x+r.w/2,z:r.z-r.d/2},
        {x:r.x+r.w/2,z:r.z+r.d/2},
        {x:r.x-r.w/2,z:r.z+r.d/2}
    ];

    for(let i=0;i<4;i++){

        const a=worldToMinimap(corners[i].x,corners[i].z);
        const b=worldToMinimap(corners[(i+1)%4].x,corners[(i+1)%4].z);

        const dx=b.x-a.x;
        const dy=b.y-a.y;
        const len=Math.sqrt(dx*dx+dy*dy);
        const angle=Math.atan2(dy,dx);

        const line=document.createElement('div');

        line.className='minimapWall';

        line.style.left=`${a.x}px`;
        line.style.top=`${a.y}px`;
        line.style.width=`${len}px`;
        line.style.height='2px';
        line.style.transform=`rotate(${angle}rad)`;

        minimapWalls.appendChild(line);
    }
}

