name:'Rifle',
mag:30,baseMag:30,ammo:30,reserve:120,
damage:24,baseDamage:24,
spread:0.008,recoil:0.06,
wave:'sawtooth',fireRate:.09,auto:true,
chBase:8,chRecoil:4,chMax:25
},
{
name:'Shotgun',
mag:8,baseMag:8,ammo:8,reserve:40,
