    g.add(frontSight);

    // 照门
    const rearSight = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.03, 0.02), matMetal);
    rearSight.position.set(0, 0.12, 0.15);
    rearSight.name = 'keep_in_ads';
    g.add(rearSight);

    return g;
}

