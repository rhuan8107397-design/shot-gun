//////////////////////////////////////////////////////////////
// ===== 碰撞 =====
//////////////////////////////////////////////////////////////

function collide(pos){

if(boss){

    const d =
    boss.mesh.position.distanceTo(pos);

    if(d<3.5){

        return true;
    }
}

for(const w of walls){

const dx=Math.abs(pos.x-w.position.x);
const dz=Math.abs(pos.z-w.position.z);

if(
dx<(w.geometry.parameters.width/2)+0.5 &&
dz<(w.geometry.parameters.depth/2)+0.5
){
return true;
}
}

return false;
}

//////////////////////////////////////////////////////////////
// ===== 敌人系统 =====
//////////////////////////////////////////////////////////////

const enemies=[];
const aliveEnemyMeshes = [];

//////////////////////////////////////////////////////////////
// ===== 爆炸碎片对象池 =====
//////////////////////////////////////////////////////////////

for(let i=0;i<40;i++){

    const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(0.25,0.25,0.25),
        new THREE.MeshStandardMaterial({
            color:0x552200,
            emissive:0x221100
        })
    );

    mesh.visible = false;

    scene.add(mesh);

    explosionFragments.push({
        mesh,
        active:false,
        velocity:new THREE.Vector3(),
        life:0
    });
}

function spawnExplosionFragments(pos){

    let spawned = 0;

    for(const f of explosionFragments){

        if(spawned>=10)break;

        if(!f.active){

            f.active = true;
            f.life = 1.2;

            f.mesh.visible = true;
            f.mesh.position.copy(pos);

            f.velocity.set(
                (Math.random()-0.5)*10,
                Math.random()*8+4,
                (Math.random()-0.5)*10
            );

            spawned++;
        }
    }
}

function explodeBarrel(barrel){

    if(!barrel.alive)return;

    barrel.alive = false;

    tempExplosionPos.copy(
        barrel.mesh.position
    );

    const pos = tempExplosionPos;

    playExplosionSound();

    const light = new THREE.PointLight(
        0xffaa00,
        10,
        15
    );

    light.position.copy(pos);

    scene.add(light);

    setTimeout(()=>{

        scene.remove(light);

    },300);

    spawnExplosionFragments(pos);

    for(const enemy of enemies){

        if(!enemy.alive)continue;

        const dist =
        enemy.mesh.position.distanceTo(pos);

        if(dist<=8){

            enemy.hp -= 80;

            enemy.body.material.color.set(0xffcc66);
            enemy.flashTimer = 0.1;

            if(enemy.hp<=0){

                enemy.alive = false;
                enemy.deadTimer = 1;

                kills++;

                score += 100;
                scoreEl.textContent = score;

                showCenterText('EXPLOSION KILL','orange',600);
            }
        }
    }

    const playerDist =
    camera.position.distanceTo(pos);

    if(playerDist<=8 && !player.invincible){

        damage(30);
    }

    // 烧焦痕迹：复用弹痕贴花逻辑，放大到 2×2，贴在地面
    const scorch = new THREE.Mesh(
        new THREE.PlaneGeometry(2,2),
        new THREE.MeshBasicMaterial({
            map:markTex,
            transparent:true,
            opacity:0.9
        })
    );

    scorch.rotation.x = -Math.PI/2;
    scorch.position.set(
        pos.x,
        0.03,
        pos.z
    );

    scene.add(scorch);

    bulletMarks.push({
        mesh:scorch,
        life:8
    });

    scene.remove(barrel.mesh);
}

function hitBarrel(barrel){

    if(!barrel.alive)return;

    barrel.hp--;

    barrel.body.material.color.set('#ffcc00');

    barrel.flashTimer = 0.08;

    if(barrel.hp<=0){

        explodeBarrel(barrel);
    }
}

