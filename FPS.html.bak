//////////////////////////////////////////////////////////////
// ===== 弹痕系统 =====
//////////////////////////////////////////////////////////////

const bulletMarks=[];

const markCanvas=document.createElement('canvas');
markCanvas.width=64;
markCanvas.height=64;
const mctx=markCanvas.getContext('2d');
mctx.fillStyle='rgba(0,0,0,.8)';
mctx.beginPath();
mctx.arc(32,32,12,0,Math.PI*2);
mctx.fill();

const markTex=new THREE.CanvasTexture(markCanvas);

function bulletMark(hit,normal){

if(
    !normal ||
    !isFinite(normal.x) ||
    !isFinite(normal.y) ||
    !isFinite(normal.z)
){
    return;
}

const mesh = new THREE.Mesh(
new THREE.PlaneGeometry(.5,.5),
new THREE.MeshBasicMaterial({
map:markTex,
transparent:true
})
);

mesh.position.copy(hit);

tempLook.copy(hit).add(normal);

mesh.lookAt(tempLook);

scene.add(mesh);

bulletMarks.push({mesh,life:5});
}

//////////////////////////////////////////////////////////////
// ===== 射击 =====
//////////////////////////////////////////////////////////////

document.addEventListener('mousedown',e=>{
if(e.button===0){

    mouseDown=true;

    if(currentWeapon===3){
        if(grenadeState==='idle'){
            startCharge();
        }
    }else{
        shoot();
    }
}
if(e.button===2){

if(!player.sprinting && !player.sliding){
    player.ads = !player.ads;
}
}
});

document.addEventListener('mouseup',e=>{
if(e.button===0){
    mouseDown=false;
    if(currentWeapon===3 && grenadeState==='charging'){
        releaseGrenade();
    }
}
});

function shoot(){

if(
    paused ||
    gameOver ||
    reloading ||
    player.sprinting ||
    player.sliding ||
    player.slideStunTimer > 0
)return;

if(currentWeapon===3)return; // grenade uses charge mechanic instead

const w=weapons[currentWeapon];
if(fireCooldown>0)return;

fireCooldown = w.fireRate;

if(w.ammo<=0){

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type='triangle';
    osc.frequency.value=800;

    gain.gain.value=0.1;

    gain.gain.exponentialRampToValueAtTime(
        0.001,
        audioCtx.currentTime+0.05
    );

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime+0.05);

    return;
}

w.ammo--;
updateHUD();

sound('gun');

recoilX +=
(Math.random()*0.02+0.01)
*
weapons[currentWeapon].recoil
*
(player.ads?4:8);

recoilY +=
(Math.random()-0.5)*0.02;

firePenalty += w.chRecoil;
firePenalty = Math.min(firePenalty, w.chMax);
lastFireTime = performance.now();

muzzle.color.set('#ffaa33');
muzzle.intensity=4;

currentWeaponModel.position.z = -0.5;

// 手枪滑套后坐动画
if (currentWeapon === 0) {
    const slide = currentWeaponModel.getObjectByName('slide');
    if (slide) {
        slide.position.z += 0.08;
        setTimeout(() => { slide.position.z -= 0.08; }, 80);
    }
}
// 步枪弹匣晃动
if (currentWeapon === 1) {
    const mag = currentWeaponModel.getObjectByName('mag');
    if (mag) {
        mag.rotation.z = 0.03;
        setTimeout(() => { mag.rotation.z = 0; }, 100);
    }
}

const pellets = currentWeapon===2?5:1;

for(let i=0;i<pellets;i++){

const spread = player.ads
? w.spread*0.5
: w.spread;

tempMouse.set(
(Math.random()-.5)*spread,
(Math.random()-.5)*spread
);

const mouse = tempMouse;

raycaster.setFromCamera(mouse,camera);

aliveEnemyMeshes.length = 0;

for(const e of enemies){

if(e.alive){

aliveEnemyMeshes.push(e.mesh);
}
}

const enemyHits = raycaster.intersectObjects(
aliveEnemyMeshes,
true
);

const aliveBarrelMeshes = barrels
.filter(b=>b.alive)
.map(b=>b.mesh);

const barrelHits = raycaster.intersectObjects(
aliveBarrelMeshes,
true
);

let bossHit=[];

if(boss){

bossHit =
raycaster.intersectObject(
boss.mesh,
true
);
}

const wallHits = raycaster.intersectObjects(walls,false);

if(
    barrelHits.length &&
    (!wallHits.length || barrelHits[0].distance < wallHits[0].distance) &&
    (!enemyHits.length || barrelHits[0].distance < enemyHits[0].distance)
){

    const barrelHit = barrelHits[0];

    const barrel = barrels.find(b=>{

        if(!barrelHit.object)return false;

        return (
            b.mesh===barrelHit.object.parent ||
            b.mesh===barrelHit.object
        );
    });

    if(barrel){

        hitBarrel(barrel);
    }

    continue;
}

if(
boss &&
bossHit.length &&
(
!wallHits.length ||
bossHit[0].distance<
wallHits[0].distance
)
){

    const w=
    weapons[currentWeapon];

    let damage=w.damage;

    if(currentWeapon===2){

        damage*=1.2;
    }

    boss.hp -= damage;

    spawnDamageNumber(
        bossHit[0].point,
        damage,
        'headshot'
    );

    recoilX +=
    w.recoil*.4;

    if(boss.hp<=0){

        if(bossHit.length>0 && bossHit[0].object.name==='head'){
            triggerHeadshotSlowmo();
        }

        boss.dead=true;

        recoilX += 0.08;
        recoilY += (Math.random() - 0.5) * 0.05;
        triggerHitMarker('kill');
        showKillIcon('boss');
        playKillConfirmSound('boss');

        score += 1000;

        scoreEl.textContent=score;

        for(let i=0;i<3;i++){

            const hpPos =
            tempNext;

            hpPos.copy(
                boss.mesh.position
            );

            hpPos.x += i*2;

            spawnSpecificPickup(
                hpPos,
                'hp'
            );

            const ammoPos =
            tempForward;

            ammoPos.copy(
                boss.mesh.position
            );

            ammoPos.z += i*2;

            spawnSpecificPickup(
                ammoPos,
                'ammo'
            );
        }
    }

    return;
}

if(enemyHits.length&&(!wallHits.length||enemyHits[0].distance<wallHits[0].distance)){

const hit = enemyHits[0];

const isHeadshot =
hit.object.name==='head';

let hitRoot = enemyHits[0].object;

while(
    hitRoot &&
    !enemies.some(e=>e.mesh===hitRoot)
){
    hitRoot = hitRoot.parent;
}

const enemy = enemies.find(
    e=>e.mesh===hitRoot
);

if(!enemy)return;

if(enemy){

let damage = w.damage;
let damageNumberType = 'normal';

if(isHeadshot){

    if(enemy.type==='elite' && enemy.helmet){

        enemy.helmet = false;

        enemy.headVisual.material.color.set('#ffcccc');

        damage *= 1.2;

        damageNumberType = 'armor';

    }else{

        damage *= 2.5;

        damageNumberType = 'headshot';

        headshotEffect();
        recoilX += 0.04;
        recoilY += (Math.random() - 0.5) * 0.02;
        triggerHitMarker('head');
    }
} else {
    recoilX += 0.015;
    triggerHitMarker('body');
}

enemy.hp -= damage;

spawnDamageNumber(
    hit.point,
    damage,
    damageNumberType
);

const knock =
0.3 * damage / 10;

const knockDir = enemy.tempVec;

knockDir.subVectors(
enemy.mesh.position,
camera.position
);

knockDir.y=0;

knockDir.normalize();

const knockPos = enemy.moveVec;

knockPos.copy(enemy.mesh.position);

knockPos.x += knockDir.x * knock;
knockPos.z += knockDir.z * knock;

if(!collide(knockPos)){

enemy.mesh.position.copy(knockPos);
}

enemy.body.material.color.set(

enemy.type==='elite'
?0xffcc66
:0xffffff
);

enemy.flashTimer = 0.06;

if(enemy.hp<=0&&enemy.alive){

if(isHeadshot){
    triggerHeadshotSlowmo();
}

enemy.alive=false;
enemy.deadTimer=1;

// 击杀反馈
recoilX += enemy.type==='elite'?0.06:(enemy.type==='boss'?0.08:0.05);
recoilY += (Math.random()-0.5)*(enemy.type==='elite'?0.04:(enemy.type==='boss'?0.05:0.03));
triggerHitMarker('kill');
showKillIcon(enemy.type);
playKillConfirmSound(enemy.type);

kills++;

if(comboTimer>0){

combo++;

}else{

combo=1;
}

comboTimer=3;

bestCombo=Math.max(
bestCombo,
combo
);

comboText.style.opacity=1;

comboText.innerHTML=
`COMBO x${combo}`;

const gainScore = Math.floor(

(

100

+

(isHeadshot?50:0)

)

*

(1+combo*0.2)

);

score+=gainScore;

scoreEl.textContent=score;

sound('kill');

showCenterText('KILL +100','red',500);

if(enemy.type==='elite'){

    spawnSpecificPickup(
        enemy.mesh.position,
        'hp'
    );

    const ammoPos = tempNext;
    ammoPos.copy(enemy.mesh.position);
    ammoPos.x += 1;

    spawnSpecificPickup(
        ammoPos,
        'ammo'
    );

}else{

spawnPickup(enemy.mesh.position);
}
}
}
}
else if(wallHits.length){

if(
    wallHits[0].face &&
    wallHits[0].face.normal
){
    bulletMark(
        wallHits[0].point,
        wallHits[0].face.normal
    );
}
}
}
}

//////////////////////////////////////////////////////////////
// ===== 换弹 =====
//////////////////////////////////////////////////////////////

function reload(){

if(currentWeapon===3)return; // grenade auto-reloads

const w=weapons[currentWeapon];

if(reloading)return;
if(w.ammo===w.mag)return;
if(w.reserve<=0)return;

reloading=true;

const reloadTime=1200*(1-0.15*player.upgrades.reload);
const soundDelay=reloadTime/1200*350;

[600,500,400].forEach((freq,i)=>{

    setTimeout(()=>{

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type='square';
        osc.frequency.value=freq;

        gain.gain.value=0.08;

        gain.gain.exponentialRampToValueAtTime(
            0.001,
            audioCtx.currentTime+0.08
        );

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime+0.08);

    },i*soundDelay);

});

setTimeout(()=>{

const need = w.mag-w.ammo;
const give = Math.min(need,w.reserve);

w.ammo+=give;
w.reserve-=give;

reloading=false;
updateHUD();

},reloadTime);
}

//////////////////////////////////////////////////////////////
// ===== 玩家受伤 =====
//////////////////////////////////////////////////////////////

function damage(v){

if(player.invincible)return;

player.hp-=v;

hpEl.textContent=Math.max(0,Math.floor(player.hp));

const dmg=document.getElementById('damage');
dmg.style.opacity=.35;

sound('hurt');

setTimeout(()=>dmg.style.opacity=0,100);

if(player.hp<=0){
lose();
}
}

//////////////////////////////////////////////////////////////
// ===== AI 更新 =====
//////////////////////////////////////////////////////////////

function enemyShoot(enemy){

enemy.attack=enemy.shootCD;

const dir = enemy.shootVec;

dir.subVectors(
camera.position,
enemy.mesh.position
).normalize();

raycaster.set(enemy.mesh.position,dir);

const wallHit = raycaster.intersectObjects(walls,false);

const dist = enemy.mesh.position.distanceTo(camera.position);

if(!wallHit.length||wallHit[0].distance>dist){
tempLinePoints[0].copy(enemy.mesh.position);
tempLinePoints[1].copy(camera.position);

enemyLaserGeom.setFromPoints(tempLinePoints);

enemyLaser.visible = true;

setTimeout(()=>{

    enemyLaser.visible = false;

},50);

damage(enemy.damage);
}
}

function updateBoss(dt){

    if(!boss)return;

    if(!boss.spawned){

        boss.spawnTimer -= dt;

        const t =
        1-boss.spawnTimer/1.5;

        boss.mesh.position.y =
        THREE.MathUtils.lerp(
            30,
            2.5,
            t
        );

        if(boss.spawnTimer<=0){

            boss.spawned=true;

            boss.mesh.position.y=2.5;

            recoilX += 0.04;

            recoilY +=
            (Math.random()-.5)*0.06;

            playBossBoom();
        }

        return;
    }

    if(boss.dead){

        boss.deathTimer -= dt;

        boss.mesh.rotation.y += dt*5;

        const s =
        Math.max(
            0,
            boss.deathTimer
        );

        boss.mesh.scale.setScalar(s);

        if(boss.deathTimer<=0){

            scene.remove(boss.mesh);

            boss=null;

            bossBarWrap.style.display='none';

            playVictoryHorn();

            win();
        }

        return;
    }

    bossBar.style.width =
    `${boss.hp/500*100}%`;

    boss.modeTimer -= dt;

    if(boss.modeTimer<=0){

        boss.modeTimer=8;

        boss.mode =
        Math.random()>.5
        ?'range'
        :'charge';

        boss.body.material.color
        .set(0xffffff);

        setTimeout(()=>{

            if(boss){

                boss.body.material.color
                .set('#6600cc');
            }

        },200);
    }

    const dist =
    boss.mesh.position.distanceTo(
        camera.position
    );

    boss.hitCooldown -= dt;

    if(boss.hitCooldown < 0){

        boss.hitCooldown = 0;
    }

    if(boss.mode==='range'){

        const dir = tempMove;

        dir.subVectors(
            camera.position,
            boss.mesh.position
        );

        dir.y=0;

        dir.normalize();

        boss.mesh.position.x +=
        dir.x * boss.speed * dt;

        boss.mesh.position.z +=
        dir.z * boss.speed * dt;

        boss.attackTimer -= dt;

        if(
            dist>15 &&
            boss.attackTimer<=0
        ){

            boss.attackTimer=1.4;

            for(let i=0;i<2;i++){

                setTimeout(()=>{

                    if(!boss)return;

                    const origin = tempForward;

                    origin.copy(boss.mesh.position);

                    origin.y += 2;

                    const dir = tempRight;

                    dir.subVectors(
                        camera.position,
                        origin
                    );

                    const dist = dir.length();

                    dir.normalize();

                    raycaster.set(origin,dir);

                    const wallHit =
                    raycaster.intersectObjects(
                        walls,
                        false
                    );

                    if(
                        wallHit.length &&
                        wallHit[0].distance < dist
                    ){
                        return;
                    }

                    damage(8);

                },i*300);
            }
        }

    }else{

        boss.chargeTimer += dt;

        const dir = tempMove;

        dir.subVectors(
            camera.position,
            boss.mesh.position
        );

        dir.y=0;

        dir.normalize();

        boss.mesh.position.x +=
        dir.x * 12 * dt;

        boss.mesh.position.z +=
        dir.z * 12 * dt;

        if(
            dist < 2.5 &&
            boss.hitCooldown <= 0
        ){

            boss.hitCooldown = 1;

            damage(15);

            const pushPos = tempNext;

            pushPos.copy(camera.position);

            pushPos.addScaledVector(dir,5);

            if(!collide(pushPos)){

                camera.position.copy(pushPos);
            }
        }

        if(boss.chargeTimer>=1){

            boss.chargeTimer=0;

            boss.mode='range';
        }
    }
}

function updateEnemies(dt){

for(let i=enemies.length-1;i>=0;i--){

const e = enemies[i];

if(!e.alive){

e.deadTimer-=dt;

e.mesh.rotation.z+=dt*3;

if(e.deadTimer<=0){

scene.remove(e.mesh);

enemies.splice(i,1);
}

continue;
}

if(e.flashTimer>0){

e.flashTimer -= dt;

if(e.flashTimer<=0){

e.body.material.color.set(

e.type==='elite'
?0xffaa00
:0xff3333

);
}
}

if(e.spawn < 1){

    // 1 秒内从 -2 上升到 1.25
    e.spawn += dt;

    const t = Math.min(1,e.spawn);

    e.mesh.position.y = THREE.MathUtils.lerp(
        -2,
        1.25,
        t
    );

    e.mesh.scale.setScalar(t);

    continue;
}

if(!e.spawnDone){

    e.spawnDone = true;

    e.mesh.position.y = 1.25;
    e.mesh.scale.setScalar(1);
}

if(e.spawnDone && e.spawnLight){

    e.spawnLightTimer -= dt;

    e.spawnLight.intensity =
    Math.max(
        0,
        2 * (e.spawnLightTimer / 0.3)
    );

    if(e.spawnLightTimer <= 0){

        e.mesh.remove(e.spawnLight);

        e.spawnLight = null;
    }
}

const toPlayer = e.tempVec;

toPlayer.set(
camera.position.x-e.mesh.position.x,
0,
camera.position.z-e.mesh.position.z
);

const dist = toPlayer.length();

const visible = canSeePlayer(e);

if(dist<28&&visible){
e.state='chase';
}else{
e.state='patrol';
}

if(e.state==='patrol'){

e.dir+=dt;

e.mesh.position.x+=Math.cos(e.dir)*dt;
e.mesh.position.z+=Math.sin(e.dir)*dt;
}

if(e.state==='chase'){

toPlayer.normalize();

const next = e.moveVec;

next.copy(e.mesh.position);

next.x+=toPlayer.x*e.speed*dt;
next.z+=toPlayer.z*e.speed*dt;

// 简单绕墙
if(collide(next)){

next.x+=Math.cos(e.dir+Math.PI/2)*dt*3;
next.z+=Math.sin(e.dir+Math.PI/2)*dt*3;
}

if(!collide(next)){
e.mesh.position.copy(next);
}

if(dist<20){

e.attack-=dt;

if(e.attack<=0){
enemyShoot(e);
}
}

// 面向玩家

e.mesh.lookAt(
camera.position.x,
e.mesh.position.y,
camera.position.z
);
}
}

let aliveCount = 0;

for(const e of enemies){

if(e.alive){
aliveCount++;
}
}

if(!waitingWave && aliveCount===0){

    if(
        wave===5 &&
        !bossSpawned
    ){

        bossSpawned=true;

        spawnBoss();

        return;
    }

    if(
        wave===5 &&
        bossSpawned &&
        !boss
    ){

        win();

        return;
    }

    waitingWave=true;

centerText.innerHTML='PRESS B FOR SHOP';
centerText.style.color='#00ffaa';
centerText.style.opacity=1;

setTimeout(()=>{
    if(gameOver) return;

    let t=3;

    centerText.style.color='white';
    centerText.style.opacity=1;

    const int = setInterval(()=>{

        if(paused || gameOver){
            return;
        }

        centerText.innerHTML=`WAVE ${wave} CLEARED! NEXT WAVE IN ${t}...`;

        t--;

        if(t<0){

            clearInterval(int);
            centerText.style.opacity=0;
            waitingWave=false;
            nextWave();
        }

    },1000);
},2000);
}
}

//////////////////////////////////////////////////////////////
// ===== 胜利/失败 =====
//////////////////////////////////////////////////////////////

function win(){

gameOver=true;

let newRecord=false;

if(score>bestScore){

localStorage.setItem(
'fps_best',
score
);

newRecord=true;
}

document.exitPointerLock();
endTitle.innerHTML='YOU WIN';

document.getElementById('stats')
.innerHTML=
`

<div>Score: ${score}</div>

<div>Best Combo: ${bestCombo}</div>

<div>Kills: ${kills}/${totalEnemies}</div>

<div>BEST: ${Math.max(score,bestScore)}</div>

${newRecord
?'<div style="color:gold">NEW RECORD!</div>'
:''}

`;

endMenu.classList.remove('hidden');
}

function lose(){

gameOver=true;

let newRecord=false;

if(score>bestScore){

localStorage.setItem(
'fps_best',
score
);

newRecord=true;
}

document.exitPointerLock();
endTitle.innerHTML='YOU DIED';
document.getElementById('stats')
.innerHTML=
`

<div>Score: ${score}</div>

<div>Best Combo: ${bestCombo}</div>

<div>Kills: ${kills}/${totalEnemies}</div>

<div>TIME: ${timeText.innerHTML}</div>

<div>BEST: ${Math.max(score,bestScore)}</div>

${newRecord
?'<div style="color:gold">NEW RECORD!</div>'
:''}

`;
endMenu.classList.remove('hidden');
}

function playSlideSound(){

    const buffer = audioCtx.createBuffer(1,4096,44100);
    const data = buffer.getChannelData(0);

    for(let i=0;i<data.length;i++){
        data[i]=(Math.random()*2-1)*0.25;
    }

    const src = audioCtx.createBufferSource();
    const filter = audioCtx.createBiquadFilter();
    const gain = audioCtx.createGain();

    filter.type='highpass';
    filter.frequency.value=800;

    gain.gain.setValueAtTime(0.1,audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(
        0.001,
        audioCtx.currentTime+0.3
    );

    src.buffer=buffer;

    src.connect(filter);
    filter.connect(gain);
    gain.connect(audioCtx.destination);

    src.start();
    src.stop(audioCtx.currentTime+0.3);
}

function startSlide(){

    player.sliding = true;
    player.ads = false;
    player.sprinting = false;
    player.invincible = true;

    player.slideTimer = 0.35;
    player.slideStunTimer = 0;

    player.targetHeight = 0.9;

    camera.getWorldDirection(player.slideDir);
    player.slideDir.y = 0;
    player.slideDir.normalize();

    playSlideSound();

    recoilX += 0.05;
}

function updatePlayer(dt){

// 原来的：
//FPS移动
//重力
//ADS
//recoil
//脚步
//全部放这里
////////////////////////////////////////////////////////////
// FPS 移动
////////////////////////////////////////////////////////////

if(weapons[currentWeapon].ammo <= 0){
    player.sprinting = false;
}

const forward = tempForward;

camera.getWorldDirection(forward);

forward.y = 0;
forward.normalize();

const right = tempRight;

right.set(
    -forward.z,
    0,
    forward.x
);

const move = tempMove;

move.set(0,0,0);

if(keys['KeyW']) move.add(forward);
if(keys['KeyS']) move.sub(forward);
if(keys['KeyA']) move.sub(right);
if(keys['KeyD']) move.add(right);

const moving = move.lengthSq() > 0;

if(player.stamina <= 0){
    player.sprinting = false;
}

if(!moving){
    player.sprinting = false;
}

if(player.sprinting && moving && !player.sliding){

    player.stamina -= dt;

    if(player.stamina <= 0){
        player.stamina = 0;
        player.sprinting = false;
    }

}else if(!player.sliding){

    player.stamina += dt * 0.75;

    if(player.stamina > player.maxStamina){
        player.stamina = player.maxStamina;
    }
}

player.speed = player.sprinting
? player.sprintSpeed
: player.baseSpeed;

if(moving && !player.sliding && player.slideStunTimer <= 0){

    if(Math.abs(player.vel.y) < 0.01){

        footstepTimer -= dt;

        if(footstepTimer <= 0){

            footstepTimer = 0.35;

            const buffer = audioCtx.createBuffer(
                1,
                2048,
                44100
            );

            const data = buffer.getChannelData(0);

            for(let i=0;i<data.length;i++){
                data[i] = (Math.random()*2-1)*0.2;
            }

            const src = audioCtx.createBufferSource();
            const filter = audioCtx.createBiquadFilter();
            const gain = audioCtx.createGain();

            filter.type = 'lowpass';
            filter.frequency.value = 300;

            gain.gain.value = 0.08;

            src.buffer = buffer;

            src.connect(filter);
            filter.connect(gain);
            gain.connect(audioCtx.destination);

            src.start();
            src.stop(audioCtx.currentTime + 0.06);
        }
    }

    move.normalize();

    crosshairTarget = Math.max(crosshairTarget, weapons[currentWeapon].chBase + (player.sprinting?12:6));

    const next = tempNext;

    next.copy(camera.position);

    next.x += move.x * player.speed * dt;
    next.z += move.z * player.speed * dt;

    if(!collide(next)){

        camera.position.x = next.x;
        camera.position.z = next.z;
    }

}else{

    crosshairTarget = Math.max(crosshairTarget, weapons[currentWeapon].chBase);
}

if(player.sliding){

    player.slideTimer -= dt;

    const slideNext = tempNext;

    slideNext.copy(camera.position);

    slideNext.x += player.slideDir.x * player.slideSpeed * dt;
    slideNext.z += player.slideDir.z * player.slideSpeed * dt;

    if(!collide(slideNext)){
        camera.position.x = slideNext.x;
        camera.position.z = slideNext.z;
    }

    player.pitch += Math.sin(performance.now()*0.04)*0.002;

    if(player.slideTimer <= 0){

        player.sliding = false;
        player.invincible = false;
        player.slideStunTimer = 0.3;
        player.targetHeight = 1.8;
    }
}

if(player.slideStunTimer > 0){

    player.slideStunTimer -= dt;

    crosshairTarget = Math.max(crosshairTarget, weapons[currentWeapon].chBase + 30);

    if(player.slideStunTimer < 0){
        player.slideStunTimer = 0;
    }
}

player.height +=
(player.targetHeight-player.height)*12*dt;

////////////////////////////////////////////////////////////
// 重力
////////////////////////////////////////////////////////////

player.vel.y-=22*dt;
if(camera.position.y>player.height+0.05){
    wasAirborne=true;
}
camera.position.y+=player.vel.y*dt;

if(camera.position.y<=player.height){

camera.position.y=player.height;
player.vel.y=0;
player.canJump=true;

if(wasAirborne){

    wasAirborne=false;

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type='sine';
    osc.frequency.value=120;

    gain.gain.value=0.15;

    gain.gain.exponentialRampToValueAtTime(
        0.001,
        audioCtx.currentTime+0.1
    );

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime+0.1);

    recoilX += 0.02;
}
}

}

function updateWeaponADSVisibility(){
    // ADS时隐藏非必要部件，只保留瞄准相关的顶部轮廓
    const isADS = adsLerp > 0.5;
    currentWeaponModel.traverse(child => {
        if (!child.isMesh) return;
        // 滑套/弹匣/泵动护木等有专属name，通过userData.adsRole标记ADS角色
        const role = (child.name === 'slide' || child.name === 'mag' || child.name === 'pump')
            ? child.userData.adsRole
            : child.name;
        if (role === 'hide_in_ads') {
            child.visible = !isADS;
        } else if (role === 'keep_in_ads') {
            child.visible = true;
        }
    });
}

function updateWeapon(dt){

    // weapon model lerp
    // muzzle flash
    // recoil recover
    // crosshair
    ////////////////////////////////////////////////////////////
    // 武器恢复 + ADS视野优化
    ////////////////////////////////////////////////////////////

    // ADS位置上移+略偏右+缩小，释放准星下方视野
    const targetX = THREE.MathUtils.lerp(0.45, 0.12, adsLerp);
    const targetY = THREE.MathUtils.lerp(-0.35, -0.05, adsLerp);
    const targetZ = THREE.MathUtils.lerp(-0.90, -0.35, adsLerp);
    const targetScale = THREE.MathUtils.lerp(1.15, 0.55, adsLerp);

    currentWeaponModel.position.x +=
    (targetX-currentWeaponModel.position.x)
    *12*dt;

    currentWeaponModel.position.y +=
    (targetY-currentWeaponModel.position.y)
    *12*dt;

    currentWeaponModel.position.z +=
    (targetZ-currentWeaponModel.position.z)
    *12*dt;

    currentWeaponModel.scale.setScalar(
        THREE.MathUtils.lerp(currentWeaponModel.scale.x, targetScale, 12 * dt)
    );

    updateWeaponADSVisibility();

    muzzle.intensity+=(-muzzle.intensity)*18*dt;

    }
function updatePickups(dt){

// 原 pickup 内容
////////////////////////////////////////////////////////////
// 掉落物检测
////////////////////////////////////////////////////////////

for(let i=pickups.length-1;i>=0;i--){

const p=pickups[i];

p.life-=dt;

p.mesh.rotation.y+=dt*2;

if(camera.position.distanceTo(p.mesh.position)<2){

if(p.type==='hp'){
player.hp=Math.min(100,player.hp+25);
hpEl.textContent=player.hp;
pickupTextShow('+25 HP','#00ff88');
}
else if(p.type==='grenade'){
weapons[3].reserve++;
updateHUD();
pickupTextShow('+Grenade','#ffdd44');
}
else{
const w=weapons[currentWeapon];
w.reserve+=w.mag;
updateHUD();
pickupTextShow('+Ammo','#ffcc00');
}

sound('pickup');

scene.remove(p.mesh);
pickups.splice(i,1);
continue;
}

if(p.life<=0){
scene.remove(p.mesh);
pickups.splice(i,1);
}
}

}
//////////////////////////////////////////////////////////////
// ===== Grenade system =====
//////////////////////////////////////////////////////////////

let grenadeState='idle'; // idle | charging | thrown
let chargeStartTime=0;
let chargeSoundOsc=null;
let chargeSoundGain=null;
let chargeFullPlayed=false;

const chargeWrapEl=document.getElementById('grenadeChargeWrap');
const chargeBarEl=document.getElementById('grenadeChargeBar');

const activeGrenades=[];
const grenadeTrailPool=[];
const grenadeLightBalls=[];

const _gnTempDir=new THREE.Vector3();
const _gnTempPos=new THREE.Vector3();

// trail particle pool (20)
for(let i=0;i<20;i++){
    const mesh=new THREE.Mesh(
        new THREE.BoxGeometry(0.05,0.05,0.05),
        new THREE.MeshBasicMaterial({color:'#aaffaa',transparent:true,opacity:0})
    );
    mesh.visible=false;
    scene.add(mesh);
    grenadeTrailPool.push({mesh,active:false,life:0});
}

// explosion light ball pool (5)
for(let i=0;i<5;i++){
    const geo=new THREE.SphereGeometry(0.1,16,16);
    const mat=new THREE.MeshBasicMaterial({color:'#ffaa00',transparent:true,opacity:0,depthWrite:false});
    const mesh=new THREE.Mesh(geo,mat);
    mesh.visible=false;
    scene.add(mesh);
    grenadeLightBalls.push({mesh,mat,geo,active:false,life:0});
}

function createGrenadeMesh(){
    const group=new THREE.Group();
    const bodyMat=new THREE.MeshStandardMaterial({color:'#335511'});
    const body=new THREE.Mesh(new THREE.CylinderGeometry(0.15,0.15,0.5,12),bodyMat);
    group.add(body);
    const ring=new THREE.Mesh(
        new THREE.TorusGeometry(0.12,0.03,8,12),
        new THREE.MeshStandardMaterial({color:'#888888'})
    );
    ring.rotation.x=Math.PI/2;
    ring.position.y=0.18;
    group.add(ring);
    return {group,bodyMat};
}

function startCharge(){
    if(grenadeState!=='idle')return;
    if(weapons[3].ammo<=0){
        // empty click sound
        const osc=audioCtx.createOscillator();
        const gain=audioCtx.createGain();
        osc.type='triangle';
        osc.frequency.value=800;
        gain.gain.value=0.1;
        gain.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+0.05);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime+0.05);
        return;
    }
    grenadeState='charging';
    chargeStartTime=performance.now();
    chargeFullPlayed=false;
    chargeWrapEl.style.opacity='1';

    // charge tension sound
    chargeSoundOsc=audioCtx.createOscillator();
    chargeSoundGain=audioCtx.createGain();
    chargeSoundOsc.type='sine';
    chargeSoundOsc.frequency.setValueAtTime(200,audioCtx.currentTime);
    chargeSoundOsc.frequency.linearRampToValueAtTime(600,audioCtx.currentTime+1.5);
    chargeSoundGain.gain.setValueAtTime(0.08,audioCtx.currentTime);
    chargeSoundOsc.connect(chargeSoundGain);
    chargeSoundGain.connect(audioCtx.destination);
    chargeSoundOsc.start();
}

function cancelCharge(){
    if(grenadeState!=='charging')return;
    grenadeState='idle';
    chargeWrapEl.style.opacity='0';
    chargeBarEl.style.width='0%';
    chargeBarEl.style.background='#33ff77';
    stopChargeSound();
}

function stopChargeSound(){
    if(chargeSoundOsc){
        try{chargeSoundOsc.stop();}catch(e){}
        chargeSoundOsc.disconnect();
        chargeSoundOsc=null;
    }
    if(chargeSoundGain){
        chargeSoundGain.disconnect();
        chargeSoundGain=null;
    }
}

function releaseGrenade(){
    if(grenadeState!=='charging')return;
    const now=performance.now();
    let chargeDuration=(now-chargeStartTime)/1000;
    if(chargeDuration<0.3)chargeDuration=0.3;
    if(chargeDuration>1.5)chargeDuration=1.5;

    grenadeState='thrown';
    chargeWrapEl.style.opacity='0';
    chargeBarEl.style.width='0%';
    chargeBarEl.style.background='#33ff77';
    stopChargeSound();

    throwGrenade(chargeDuration);
}

function throwGrenade(chargeDuration){
    const w=weapons[3];
    if(w.ammo<=0)return;

    w.ammo--;
    updateHUD();

    // velocity: 10 ~ 24 based on charge
    const speed=10+(chargeDuration-0.3)/1.2*14;

    const {group,bodyMat}=createGrenadeMesh();

    // direction: camera forward, horizontal only, 22deg upward
    _gnTempDir.set(0,0,-1);
    camera.getWorldDirection(_gnTempDir);
    _gnTempDir.y=0;
    _gnTempDir.normalize();
    _gnTempDir.y=Math.tan(22*Math.PI/180)*_gnTempDir.length();
    _gnTempDir.normalize();

    group.position.copy(camera.position);
    group.position.y+=0.3;
    scene.add(group);

    // enforce max 3 active grenades
    if(activeGrenades.length>=3){
        explodeGrenade(activeGrenades[0]);
        activeGrenades.splice(0,1);
    }

    activeGrenades.push({
        mesh:group,
        bodyMat,
        velocity:_gnTempDir.clone().multiplyScalar(speed),
        life:0,
        state:'flying',
        bounceCount:0,
        boomTimer:0
    });

    // auto-reload from reserve after throw
    setTimeout(function(){
        if(w.ammo===0&&w.reserve>0){
            w.ammo++;
            w.reserve--;
            updateHUD();
        }
        grenadeState='idle';
    },300);

    // throw sound
    const osc=audioCtx.createOscillator();
    const gain=audioCtx.createGain();
    osc.type='sine';
    osc.frequency.setValueAtTime(400,audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(150,audioCtx.currentTime+0.12);
    gain.gain.setValueAtTime(0.15,audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+0.12);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime+0.12);
}

function explodeGrenade(g){
    const pos=g.mesh.position.clone();
    scene.remove(g.mesh);

    // explosion sound (extended)
    playExplosionSound();
    const osc=audioCtx.createOscillator();
    const gain=audioCtx.createGain();
    osc.type='sawtooth';
    osc.frequency.value=55;
    gain.gain.setValueAtTime(0.3,audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+0.6);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime+0.6);

    // fragments (20 pieces, orange)
    let spawned=0;
    for(const f of explosionFragments){
        if(spawned>=20)break;
        if(!f.active){
            f.active=true;
            f.life=1.5;
            f.mesh.visible=true;
            f.mesh.position.copy(pos);
            f.mesh.material.color.set('#ff6600');
            f.mesh.material.emissive.set('#331100');
            f.velocity.set((Math.random()-0.5)*12,Math.random()*6+6,(Math.random()-0.5)*12);
            spawned++;
        }
    }

    // light ball
    for(const b of grenadeLightBalls){
        if(!b.active){
            b.active=true;
            b.life=0.25;
            b.mesh.visible=true;
            b.mesh.position.copy(pos);
            b.mesh.scale.setScalar(1);
            b.mat.opacity=0.9;
            break;
        }
    }

    // point light
    const plight=new THREE.PointLight(0xffaa00,12,18);
    plight.position.copy(pos);
    scene.add(plight);
    setTimeout(function(){scene.remove(plight);},400);

    // scorch mark
    const scorch=new THREE.Mesh(
        new THREE.PlaneGeometry(1.5,1.5),
        new THREE.MeshBasicMaterial({map:markTex,transparent:true,opacity:0.95})
    );
    scorch.rotation.x=-Math.PI/2;
    scorch.position.set(pos.x,0.03,pos.z);
    scene.add(scorch);
    bulletMarks.push({mesh:scorch,life:10});

    // screen shake if player within 15
    const pdist2=camera.position.distanceTo(pos);
    if(pdist2<=15){
        recoilX+=0.06;
        recoilY+=(Math.random()-0.5)*0.04;
    }

    // damage enemies
    for(const enemy of enemies){
        if(!enemy.alive)continue;
        const dist=enemy.mesh.position.distanceTo(pos);
        if(dist<=8){
            const dmg=weapons[3].damage*Math.max(0,1-dist/8);
            enemy.hp-=dmg;
            enemy.body.material.color.set(0xffffff);
            enemy.flashTimer=0.1;
            spawnDamageNumber(enemy.mesh.position,dmg,'normal');
            if(enemy.hp<=0&&enemy.alive){
                enemy.alive=false;
                enemy.deadTimer=1;
                kills++;
                score+=100;
                scoreEl.textContent=score;
                spawnPickup(enemy.mesh.position);
            }
        }
    }

    // damage player
    const pdist=camera.position.distanceTo(pos);
    if(pdist<=8&&!player.invincible){
        const pdmg=Math.max(10,Math.floor(50*(1-pdist/8)));
        damage(pdmg);
        _gnTempDir.subVectors(camera.position,pos).normalize();
        _gnTempDir.y=0;
        _gnTempPos.copy(camera.position).addScaledVector(_gnTempDir,3);
        if(!collide(_gnTempPos)){
            camera.position.copy(_gnTempPos);
        }
    }

    // chain reaction: barrels
    for(const b of barrels){
        if(!b.alive)continue;
        if(b.mesh.position.distanceTo(pos)<=8){
            explodeBarrel(b);
        }
    }

    // boss damage
    if(boss&&boss.alive&&!boss.dead){
        const bdist=boss.mesh.position.distanceTo(pos);
        if(bdist<=8){
            const bdmg=weapons[3].damage*Math.max(0,1-bdist/8);
            boss.hp-=bdmg;
            spawnDamageNumber(pos,bdmg,'headshot');
            if(boss.hp<=0){
                boss.dead=true;
                recoilX += 0.08;
                recoilY += (Math.random() - 0.5) * 0.05;
                triggerHitMarker('kill');
                showKillIcon('boss');
                playKillConfirmSound('boss');
                score+=1000;
                scoreEl.textContent=score;
            }
        }
    }
}

function spawnGrenadeTrail(pos){
    for(const p of grenadeTrailPool){
        if(!p.active){
            p.active=true;
            p.life=0.5;
            p.mesh.visible=true;
            p.mesh.position.copy(pos);
            p.mesh.material.opacity=0.8;
            return;
        }
    }
}

function updateGrenades(dt){
    // charge bar update
    if(grenadeState==='charging'){
        const now=performance.now();
        const elapsed=(now-chargeStartTime)/1000;
        const pct=Math.min(100,Math.max(0,elapsed/1.5*100));
        chargeBarEl.style.width=pct+'%';
        if(elapsed>=1.5){
            chargeBarEl.style.background='#ff3333';
            if(!chargeFullPlayed){
                chargeFullPlayed=true;
                // full charge ping
                const osc2=audioCtx.createOscillator();
                const gain2=audioCtx.createGain();
                osc2.type='sine';
                osc2.frequency.value=880;
                gain2.gain.setValueAtTime(0.1,audioCtx.currentTime);
                gain2.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+0.08);
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.start();
                osc2.stop(audioCtx.currentTime+0.08);
            }
        }
    }

    // update active grenades
    for(let i=activeGrenades.length-1;i>=0;i--){
        const g=activeGrenades[i];

        if(g.state==='flying'||g.state==='bouncing'){
            g.velocity.y-=22*dt;
            g.mesh.position.x+=g.velocity.x*dt;
            g.mesh.position.y+=g.velocity.y*dt;
            g.mesh.position.z+=g.velocity.z*dt;
            g.mesh.rotation.x+=dt*10;
            g.mesh.rotation.z+=dt*8;
            g.life+=dt;

            // trail every ~0.08s
            if(Math.floor(g.life/0.08)!==Math.floor((g.life-dt)/0.08)){
                spawnGrenadeTrail(g.mesh.position.clone());
            }

            // floor bounce
            if(g.mesh.position.y<=0.15){
                g.mesh.position.y=0.15;
                if(g.bounceCount<2){
                    g.velocity.y=Math.abs(g.velocity.y)*0.4;
                    g.velocity.x*=0.6;
                    g.velocity.z*=0.6;
                    g.bounceCount++;
                    g.state='bouncing';
                    // bounce sound (first only)
                    if(g.bounceCount===1){
                        const osc3=audioCtx.createOscillator();
                        const gain3=audioCtx.createGain();
                        osc3.type='square';
                        osc3.frequency.value=250;
                        gain3.gain.setValueAtTime(0.05,audioCtx.currentTime);
                        gain3.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+0.05);
                        osc3.connect(gain3);
                        gain3.connect(audioCtx.destination);
                        osc3.start();
                        osc3.stop(audioCtx.currentTime+0.05);
                    }
                }else{
                    g.state='armed';
                    g.boomTimer=2.0;
                    g.velocity.set(0,0,0);
                }
            }

            // wall collision
            _gnTempPos.copy(g.mesh.position);
            if(collide(_gnTempPos)){
                g.velocity.x*=-0.5;
                g.velocity.z*=-0.5;
                g.mesh.position.x-=g.velocity.x*dt*2;
                g.mesh.position.z-=g.velocity.z*dt*2;
            }
        }else if(g.state==='armed'){
            g.boomTimer-=dt;
            if(g.boomTimer<=0){
                explodeGrenade(g);
                activeGrenades.splice(i,1);
                continue;
            }
            // blink warning
            if(Math.floor(g.boomTimer*4)%2===0){
                g.bodyMat.emissive.set('#331100');
                g.bodyMat.emissiveIntensity=1;
            }else{
                g.bodyMat.emissiveIntensity=0;
            }
        }
    }

    // update trail particles
    for(const p of grenadeTrailPool){
        if(!p.active)continue;
        p.life-=dt;
        p.mesh.material.opacity=Math.max(0,p.life/0.5*0.8);
        if(p.life<=0){
            p.active=false;
            p.mesh.visible=false;
        }
    }

    // update light balls
    for(const b of grenadeLightBalls){
        if(!b.active)continue;
        b.life-=dt;
        const t=1-b.life/0.25;
        b.mesh.scale.setScalar(1+t*3);
        b.mat.opacity=0.9*(1-t);
        if(b.life<=0){
            b.active=false;
            b.mesh.visible=false;
        }
    }

    // minimap: update grenade dots
    updateMinimapGrenades();
}

function updateMinimapGrenades(){
    // clear previous grenade dots
    const existing=minimapEnemies.querySelectorAll('.minimapGrenadeDot');
    for(const el of existing){el.remove();}

    for(const g of activeGrenades){
        const dist=Math.sqrt(
            (g.mesh.position.x-camera.position.x)**2+
            (g.mesh.position.z-camera.position.z)**2
        );
        if(dist>80)continue;
        const pos=worldToMinimap(g.mesh.position.x,g.mesh.position.z);
        const dot=document.createElement('div');
        dot.className='minimapGrenadeDot';
        dot.style.position='absolute';
        dot.style.left=(pos.x-2)+'px';
        dot.style.top=(pos.y-2)+'px';
        dot.style.width='4px';
        dot.style.height='4px';
        dot.style.borderRadius='50%';
        dot.style.background='#ffffff';
        dot.style.zIndex='3';
        // blink: show only on even half-second
        if(Math.floor(g.life*2)%2===0||g.state==='armed'){
            dot.style.opacity='1';
        }else{
            dot.style.opacity='0.3';
        }
        minimapEnemies.appendChild(dot);
    }
}

function updateBreathingLights(time){
    const breath=Math.sin(time*0.5)*0.5+0.5; // 0~1, ~12s cycle
    const intensity=0.55+breath*0.15; // 0.55~0.70
    const emissiveIntensity=0.15+breath*0.05;
    for(const fl of fluorescentLights){
        fl.light.intensity=intensity;
        fl.mesh.material.emissiveIntensity=emissiveIntensity;
    }
}

function updateBarrelsAndFragments(dt){

    for(const b of barrels){

        if(!b.alive)continue;

        if(b.flashTimer>0){

            b.flashTimer -= dt;

            if(b.flashTimer<=0){

                b.body.material.color.set('#cc0000');
            }
        }
    }

    for(const f of explosionFragments){

        if(!f.active)continue;

        f.life -= dt;

        f.velocity.y -= 18 * dt;

        f.mesh.position.x += f.velocity.x * dt;
        f.mesh.position.y += f.velocity.y * dt;
        f.mesh.position.z += f.velocity.z * dt;

        f.mesh.rotation.x += dt * 8;
        f.mesh.rotation.y += dt * 10;

        if(f.mesh.position.y<0.1){

            f.mesh.position.y = 0.1;
            f.velocity.y *= -0.25;
            f.velocity.x *= 0.7;
            f.velocity.z *= 0.7;
        }

        if(f.life<=0){

            f.active = false;
            f.mesh.visible = false;
        }
    }
}

function updateBulletMarks(dt){

// 原来的 bulletMarks 更新
////////////////////////////////////////////////////////////
// 弹痕更新
////////////////////////////////////////////////////////////

for(let i=bulletMarks.length-1;i>=0;i--){

const b=bulletMarks[i];

b.life-=dt;

b.mesh.material.opacity=b.life/5;

if(b.life<=0){
scene.remove(b.mesh);
bulletMarks.splice(i,1);
}
}

}

function updateDamageNumbers(dt){

    for(const item of damageNumberPool){

        if(!item.active)continue;

        item.life -= dt;

        const t =
        1 - item.life / item.maxLife;

        const y =
        item.y - t * 40;

        item.el.style.top = `${y}px`;
        item.el.style.opacity = `${Math.max(0,item.life/item.maxLife)}`;

        if(item.life<=0){

            item.active = false;
            item.el.style.display = 'none';
        }
    }
}

function updateLowHpFeedback(dt){

    if(player.hp <= 30){

        lowHpActive = true;

    }else if(player.hp >= 50){

        lowHpActive = false;
    }

    if(lowHpActive){

        const intensity =
        Math.min(1,Math.max(0,1-player.hp/30));

        for(const edge of lowHpEdges){
            edge.style.opacity = intensity;
        }

        heartbeatTimer -= dt;

        if(heartbeatTimer <= 0){

            playHeartbeat();

            heartbeatTimer = 1.2;
        }

        breathTimer += dt;

        const breath =
        Math.sin(breathTimer * Math.PI) * 0.005;

        recoilX += breath;

        hemi.intensity +=
        (0.8 - hemi.intensity) * 2 * dt;

    }else{

        for(const edge of lowHpEdges){
            edge.style.opacity = 0;
        }

        heartbeatTimer = 0;
        breathTimer = 0;

        hemi.intensity +=
        (1.4 - hemi.intensity) * 2 * dt;
    }
}

function updateUI(dt){

// crosshair spread calculation
const w=weapons[currentWeapon];
// fire penalty decay
if(firePenalty>0){
    const elapsed=performance.now()-lastFireTime;
    if(elapsed<300){
        firePenalty=Math.max(0,firePenalty-(w.chRecoil*dt/0.3));
    }else{
        firePenalty=0;
    }
}

// compute target spread
let movePenaltyVal=0;
if(player.sliding||!player.canJump){
    movePenaltyVal=30;
}else if(player.sprinting){
    movePenaltyVal=12;
}else if(Math.abs(player.vel.x)>0.1||Math.abs(player.vel.z)>0.1){
    movePenaltyVal=6;
}
const adsMul=player.ads?0.25:1.0;
const target=Math.min(w.chMax,(w.chBase+movePenaltyVal+firePenalty))*adsMul;

// grenade charge shrink
if(currentWeapon===3&&grenadeState==='charging'){
    const elapsed=(performance.now()-chargeStartTime)/1000;
    crosshairTarget=Math.max(1,target*(1-elapsed/1.5*0.7));
}else{
    crosshairTarget=target;
}

// lerp spread
crosshairSpread+=(crosshairTarget-crosshairSpread)*dt*15;

// apply crosshair line positions
if(currentWeapon===2){
    chTop.style.display='none';chBottom.style.display='none';
    chLeft.style.display='none';chRight.style.display='none';
    const s=crosshairSpread*2+4;
    chCircle.style.width=s+'px';chCircle.style.height=s+'px';
    chCircle.style.border='2px solid '+crosshairConfig.color;
    chCircle.style.left=(-s/2)+'px';chCircle.style.top=(-s/2)+'px';
    chCircle.style.display='block';
    chCenter.style.opacity='0';
}else{
    chTop.style.display='block';chBottom.style.display='block';
    chLeft.style.display='block';chRight.style.display='block';
    chCircle.style.display='none';
    const sp=crosshairSpread;
    chTop.style.top=(-sp-6)+'px';chBottom.style.top=sp+'px';
    chLeft.style.left=(-sp-6)+'px';chRight.style.left=sp+'px';
    chCenter.style.opacity=(player.ads&&sp<5)?'1':'0';
    chCenter.style.background=crosshairConfig.color;
}
chRoot.style.setProperty('--ch-color',crosshairConfig.color);
chRoot.style.setProperty('--ch-outline',crosshairConfig.outlineColor);
chRoot.style.opacity=crosshairConfig.opacity;

// ads dot
adsDot.style.opacity=player.ads?'1':'0';

if(comboTimer>0){

comboTimer-=dt;

if(comboTimer<=0){

combo=0;

comboText.style.opacity=0;

showCenterText('COMBO BREAK','#888',800);
}
}

const min =
Math.floor(surviveTime/60)
.toString()
.padStart(2,'0');

const sec =
Math.floor(surviveTime%60)
.toString()
.padStart(2,'0');

timeText.innerHTML=
`${min}:${sec}`;

staminaBar.style.width =
`${(player.stamina/player.maxStamina)*100}%`;

if(player.stamina <= 0.2){
    staminaBar.style.background = '#ff4444';
}else{
    staminaBar.style.background = '#33ff77';
}

// 小地图更新
const pPos = worldToMinimap(camera.position.x, camera.position.z);
minimapPlayer.style.left = `${pPos.x - 5}px`;
minimapPlayer.style.top = `${pPos.y - 5}px`;
minimapPlayer.style.transform = `rotate(${-player.yaw}rad)`;

for(const dot of minimapEnemyDots){
    dot.active = false;
    dot.el.style.display = 'none';
}

let dotIdx = 0;

for(const e of enemies){
    if(!e.alive || dotIdx >= 30) continue;

    const dist = Math.sqrt(
        (e.mesh.position.x - camera.position.x)**2 +
        (e.mesh.position.z - camera.position.z)**2
    );

    if(dist > 80) continue;

    const pos = worldToMinimap(e.mesh.position.x, e.mesh.position.z);
    const dot = minimapEnemyDots[dotIdx];

    dot.active = true;
    dot.el.style.display = 'block';
    dot.el.style.left = `${pos.x}px`;
    dot.el.style.top = `${pos.y}px`;

    let size, color;
    if(e.type === 'elite'){
        size = 8;
        color = '#ffaa00';
    }else{
        size = 6;
        color = '#ff3333';
    }

    dot.el.style.width = `${size}px`;
    dot.el.style.height = `${size}px`;
    dot.el.style.background = color;

    dotIdx++;
}

if(boss && boss.alive && !boss.dead && dotIdx < 30){
    const dist = Math.sqrt(
        (boss.mesh.position.x - camera.position.x)**2 +
        (boss.mesh.position.z - camera.position.z)**2
    );

    if(dist <= 80){
        const pos = worldToMinimap(boss.mesh.position.x, boss.mesh.position.z);
        const dot = minimapEnemyDots[dotIdx];

        dot.active = true;
        dot.el.style.display = 'block';
        dot.el.style.left = `${pos.x}px`;
        dot.el.style.top = `${pos.y}px`;
        dot.el.style.width = '12px';
        dot.el.style.height = '12px';
        dot.el.style.background = '#aa00ff';
    }
}

}

const enemyLaserGeom =
new THREE.BufferGeometry();

const enemyLaser =
new THREE.Line(

    enemyLaserGeom,

    new THREE.LineBasicMaterial({
        color:0xff0000
    })
);

//////////////////////////////////////////////////////////////
// ===== 主循环 =====
//////////////////////////////////////////////////////////////

let footstepTimer = 0;
let wasAirborne = false;

const tempForward = new THREE.Vector3();
const tempRight = new THREE.Vector3();
const tempMove = new THREE.Vector3();
const tempNext = new THREE.Vector3();
const tempMouse = new THREE.Vector2();
const tempLook = new THREE.Vector3();
const tempScreen = new THREE.Vector3();
const tempExplosionPos = new THREE.Vector3();
const tempLinePoints = [
    new THREE.Vector3(),
    new THREE.Vector3()
];

enemyLaser.visible = false;

scene.add(enemyLaser);

let globalTime=0;
let prev=performance.now();



function loop(){

requestAnimationFrame(loop);

const now=performance.now();
const dt=Math.min((now-prev)/1000,.1);
prev=now;
globalTime+=dt;

if(whiteFlashOpacity>0){
    whiteFlashOpacity-=dt/0.15*0.5;
    if(whiteFlashOpacity<0) whiteFlashOpacity=0;
    for(const edge of flashEdges){
        edge.style.opacity=whiteFlashOpacity;
    }
}

if(!paused&&!gameOver){

started=true;

if(timeScale<1.0){
    timeScale+=(1-timeScale)*dt*4;
    if(timeScale>0.9999) timeScale=1.0;
}

const gameDt=dt*timeScale;

surviveTime+=gameDt;

camera.rotation.order='YXZ';
camera.rotation.y=player.yaw;
adsLerp += (
(player.ads?1:0)
-adsLerp
)*gameDt*10;

camera.fov = THREE.MathUtils.lerp(
75,
45,
adsLerp
);

camera.updateProjectionMatrix();

camera.rotation.x=player.pitch;

camera.rotation.x -= recoilX;
camera.rotation.y += recoilY;

recoilX *= 0.82;
recoilY *= 0.82;

if(!isFinite(camera.rotation.x)) camera.rotation.x = 0;
if(!isFinite(camera.rotation.y)) camera.rotation.y = 0;
if(!isFinite(camera.rotation.z)) camera.rotation.z = 0;


fireCooldown -= dt;

if(fireCooldown<0){
    fireCooldown=0;
}

const w = weapons[currentWeapon];

if(
    mouseDown &&
    w.auto &&
    fireCooldown<=0
){

    shoot();
}

updatePlayer(gameDt);
updateWeapon(gameDt);
updatePickups(gameDt);
updateBarrelsAndFragments(gameDt);
updateBulletMarks(gameDt);
updateDamageNumbers(gameDt);
updateLowHpFeedback(gameDt);
updateUI(gameDt);
updateHitMarker(gameDt);
updateKillFeed(gameDt);
updateEnemies(gameDt);
updateBoss(gameDt);
updateGrenades(gameDt);
updateBreathingLights(globalTime);
}

try{

    renderer.render(scene,camera);

}catch(err){

    console.error(err);
}
}

loop();

//////////////////////////////////////////////////////////////
// ===== 自适应 =====
//////////////////////////////////////////////////////////////

window.addEventListener('resize',()=>{

camera.aspect=window.innerWidth/window.innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(window.innerWidth,window.innerHeight);
});

document.addEventListener('contextmenu',e=>{
e.preventDefault();
});

</script>

</body>
</html>
```